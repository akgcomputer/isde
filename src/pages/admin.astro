  <script is:inline>
    async function triggerDbMigrate(btn) {
      const siteId = btn.getAttribute('data-site-id');
      if (!siteId) return;
      if (!confirm('Veritabanı migration çalıştırılsın mı? Eksik tablo ve kolonlar eklenecek.')) return;

      const originalHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Çalışıyor...';
      btn.style.opacity = '0.7';

      try {
        const res = await fetch('/api/admin/db-migrate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ site_id: siteId })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          alert('✅ ' + data.message);
        } else {
          alert('❌ Hata: ' + (data.error || 'Migration çalıştırılamadı.'));
        }
      } catch (err) {
        alert('Bağlantı hatası: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalHtml;
        btn.style.opacity = '1';
      }
    }

    async function triggerUpdate(btn) {
      const siteId = btn.getAttribute('data-site-id');
      if (!siteId) return;

      const originalHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Güncelleniyor...';
      btn.style.opacity = '0.7';

      try {
        const res = await fetch('/api/admin/sync-template', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ site_id: siteId })
        });
        const data = await res.json();
        
        if (res.ok && data.success) {
          alert(data.message);
        } else {
          alert("Hata: " + (data.error || "Güncelleme tetiklenemedi."));
        }
      } catch (err) {
        alert("Bağlantı hatası: " + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalHtml;
        btn.style.opacity = '1';
      }
    }
  </script>
