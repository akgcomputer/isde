---
// src/pages/admin.astro
import BasicLayout from '../layouts/BasicLayout.astro';

export const prerender = false; // Admin paneli sunucu tarafında çalışmalıdır (SSR)

// Kullanıcı bilgileri middleware tarafından enjekte edilmiştir
let user = Astro.locals.user || { name: 'Sistem Yöneticisi', email: 'admin@isdeyeter.com' };
let stats = {
  totalMembers: 0,
  totalPartners: 0,
  totalRequests: 0,
  totalOffers: 0,
  totalSites: 0
};

let recentUsers: any[] = [];
let recentRequests: any[] = [];
let recentSites: any[] = [];
let expiringSites: any[] = [];
let popularServices: any[] = [];
let partnersList: any[] = [];
let settingsMap: any = {};
let debugError: string | null = null;
let successMessage: string | null = null;

try {
  if (!Astro.locals.user || Astro.locals.user.is_partner !== 2) {
    return Astro.redirect('/login?error=unauthorized');
  }

  const runtime = Astro.locals.runtime as any;
  const db = runtime?.env?.DB;

  if (!db) {
    debugError = "Cloudflare D1 Database binding is missing! Please check Pages settings.";
  } else {
    // POST İsteklerini Yönet (Onay ve Durum Değişiklikleri ve Ayarlar)
    if (Astro.request.method === 'POST') {
      try {
        const formData = await Astro.request.formData();
        const action = formData.get('action');

        if (action === 'toggle-partner-approval') {
          const partnerId = formData.get('partner_id') as string;
          const currentApproved = parseInt(formData.get('current_approved') as string || '0');
          const newApproved = currentApproved === 1 ? 0 : 1;
          await db.prepare("UPDATE users SET is_approved = ? WHERE id = ?").bind(newApproved, partnerId).run();
          successMessage = `İş ortağı onay durumu başarıyla güncellendi.`;
        } else if (action === 'toggle-service-status') {
          const siteId = formData.get('site_id') as string;
          const currentStatus = formData.get('current_status') as string;
          const newStatus = currentStatus === 'ACTIVE' ? 'PASSIVE' : 'ACTIVE';
          await db.prepare("UPDATE sites SET status = ? WHERE id = ?").bind(newStatus, siteId).run();
          successMessage = `Hizmet aktiflik durumu başarıyla güncellendi.`;
        } else if (action === 'update-system-settings') {
          const githubPat = (formData.get('github_pat') as string || '').trim();
          const cfToken = (formData.get('cloudflare_token') as string || '').trim();
          const cfAccountId = (formData.get('cloudflare_account_id') as string || '').trim();

          await db.prepare("INSERT OR REPLACE INTO system_settings (key, value) VALUES ('github_pat', ?)")
            .bind(githubPat).run();
          await db.prepare("INSERT OR REPLACE INTO system_settings (key, value) VALUES ('cloudflare_token', ?)")
            .bind(cfToken).run();
          await db.prepare("INSERT OR REPLACE INTO system_settings (key, value) VALUES ('cloudflare_account_id', ?)")
            .bind(cfAccountId).run();

          successMessage = "Sistem API anahtarları başarıyla güncellendi.";
        }
      } catch (postErr: any) {
        console.error("POST action error:", postErr);
        debugError = `İşlem Başarısız: ${postErr.message}`;
      }
    }

    try {
      // Otomatik Süre Kontrolü: Bitiş tarihi geçmiş ve ACTIVE olan tüm hizmetleri pasifleştir
      const nowLocal = new Date().toISOString();
      await db.prepare(
        "UPDATE sites SET status = 'PASSIVE' WHERE status = 'ACTIVE' AND end_date IS NOT NULL AND end_date < ?"
      ).bind(nowLocal).run();

      // Üye sayısı
      const membersCount = await db.prepare("SELECT COUNT(*) as count FROM users WHERE is_partner = 0").first() as any;
      stats.totalMembers = membersCount?.count || 0;

      // İş ortağı sayısı
      const partnersCount = await db.prepare("SELECT COUNT(*) as count FROM users WHERE is_partner = 1").first() as any;
      stats.totalPartners = partnersCount?.count || 0;

      // Talep sayısı
      const requestsCount = await db.prepare("SELECT COUNT(*) as count FROM service_requests").first() as any;
      stats.totalRequests = requestsCount?.count || 0;

      // Teklif sayısı
      const offersCount = await db.prepare("SELECT COUNT(*) as count FROM offers").first() as any;
      stats.totalOffers = offersCount?.count || 0;

      // Aktif Hizmet sayısı
      const sitesCount = await db.prepare("SELECT COUNT(*) as count FROM sites WHERE status = 'ACTIVE'").first() as any;
      stats.totalSites = sitesCount?.count || 0;

      // Son Kayıt Olan 5 Kullanıcı
      const usersQuery = await db.prepare("SELECT * FROM users ORDER BY created_at DESC LIMIT 5").all();
      recentUsers = usersQuery.results || [];

      // Son 10 Hizmet Talebi
      const requestsQuery = await db.prepare(
        "SELECT r.*, u.name as client_name FROM service_requests r JOIN users u ON r.client_id = u.id ORDER BY r.created_at DESC LIMIT 10"
      ).all();
      recentRequests = requestsQuery.results || [];

      // Aktif / Son Kurulan Hizmetler (ACTIVE olanlar, son oluşturulan)
      const sitesQuery = await db.prepare(
        "SELECT s.*, u.name as owner_name FROM sites s JOIN users u ON s.user_id = u.id WHERE s.status = 'ACTIVE' ORDER BY s.created_at DESC LIMIT 8"
      ).all();
      recentSites = sitesQuery.results || [];

      // Süresi bitmeye yakın hizmetler (30 gün içinde)
      const now = new Date();
      const thirtyDaysLater = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000).toISOString();
      const expiringSitesQuery = await db.prepare(
        "SELECT s.*, u.name as owner_name FROM sites s JOIN users u ON s.user_id = u.id WHERE s.status = 'ACTIVE' AND s.end_date IS NOT NULL AND s.end_date <= ? ORDER BY s.end_date ASC LIMIT 8"
      ).bind(thirtyDaysLater).all();
      expiringSites = expiringSitesQuery.results || [];

      // En Popüler Hizmetler (system_settings'den 'popular_services' key'i)
      const popularSettingRow = await db.prepare("SELECT value FROM system_settings WHERE key = 'popular_services'").first();
      if (popularSettingRow?.value) {
        try { popularServices = JSON.parse(popularSettingRow.value as string); } catch(e) { popularServices = []; }
      }

      // Tüm İş Ortakları (Onay Paneli İçin)
      const partnersQuery = await db.prepare(
        "SELECT * FROM users WHERE is_partner = 1 ORDER BY created_at DESC"
      ).all();
      partnersList = partnersQuery.results || [];

      // Sistem Ayarlarını Oku
      const settingsQuery = await db.prepare("SELECT * FROM system_settings").all();
      const settingsList = settingsQuery.results || [];
      settingsList.forEach((s: any) => {
        settingsMap[s.key] = s.value;
      });

    } catch (e: any) {
      console.error("Admin dashboard query error:", e);
      debugError = `Veritabanı Sorgu Hatası: ${e.message}`;
    }
  }
} catch (globalErr: any) {
  debugError = `Global Admin Sayfa Hatası: ${globalErr.message}`;
}

// Güvenli tarih formatlama yardımcı fonksiyonu
function formatDate(dateStr: string) {
  if (!dateStr) return "N/A";
  const safeStr = dateStr.includes(' ') && !dateStr.includes('T') ? dateStr.replace(' ', 'T') + 'Z' : dateStr;
  const d = new Date(safeStr);
  if (isNaN(d.getTime())) {
    const parts = dateStr.split(' ')[0].split('-');
    if (parts.length === 3) {
      return `${parts[2]}.${parts[1]}.${parts[0]}`;
    }
    return dateStr;
  }
  return d.toLocaleDateString('tr-TR');
}
---

<BasicLayout title="Yönetim Paneli | İş De Yeter" description="İş De Yeter Platformu Merkezi Yönetim Kontrol Merkezi.">
  <div class="admin-wrapper">
    
    {debugError && (
      <div class="error-banner" style="background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; padding: 20px; border-radius: 12px; margin-bottom: 24px; color: #f87171; font-family: sans-serif;">
        <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 8px; color: #f87171;"><i class="fa-solid fa-triangle-exclamation mr-2"></i> Sistem Yönetim Hatası</h2>
        <p style="font-family: monospace; font-size: 0.9rem; margin: 0;">{debugError}</p>
      </div>
    )}

    {successMessage && (
      <div class="success-banner" style="background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; padding: 20px; border-radius: 12px; margin-bottom: 24px; color: #34d399; font-family: sans-serif;">
        <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 8px; color: #34d399;"><i class="fa-solid fa-circle-check mr-2"></i> Başarılı İşlem</h2>
        <p style="font-size: 0.9rem; margin: 0;">{successMessage}</p>
      </div>
    )}
    
    <!-- Top Nav -->
    <header class="admin-header">
      <div class="header-left">
        <span class="badge">SYSTEM ADMIN</span>
        <h1>Merkezi Kontrol Paneli</h1>
      </div>
      <div class="header-right">
        <a href="/admin/start-service" class="start-service-btn">
          <i class="fa-solid fa-plus-circle"></i>
          <span>Hizmet Başlat</span>
        </a>
        <div class="admin-profile">
          <i class="fa-solid fa-user-shield avatar-icon"></i>
          <div class="profile-details">
            <span class="admin-name">{user.name}</span>
            <span class="admin-email">{user.email}</span>
          </div>
        </div>
        <a href="/api/auth/logout" class="logout-btn">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span>Güvenli Çıkış</span>
        </a>
      </div>
    </header>

    <!-- Stats Grid -->
    <section class="stats-grid">
      
      <!-- Stat Card -->
      <div class="stat-card">
        <div class="stat-icon member-icon">
          <i class="fa-solid fa-users"></i>
        </div>
        <div class="stat-info">
          <h3>Kayıtlı Üyeler</h3>
          <p class="stat-value">{stats.totalMembers}</p>
        </div>
      </div>

      <!-- Stat Card -->
      <div class="stat-card">
        <div class="stat-icon partner-icon">
          <i class="fa-solid fa-handshake"></i>
        </div>
        <div class="stat-info">
          <h3>İş Ortakları</h3>
          <p class="stat-value">{stats.totalPartners}</p>
        </div>
      </div>

      <!-- Stat Card -->
      <div class="stat-card">
        <div class="stat-icon request-icon">
          <i class="fa-solid fa-file-invoice"></i>
        </div>
        <div class="stat-info">
          <h3>Hizmet Talepleri</h3>
          <p class="stat-value">{stats.totalRequests}</p>
        </div>
      </div>

      <!-- Stat Card -->
      <div class="stat-card">
        <div class="stat-icon offer-icon">
          <i class="fa-solid fa-tags"></i>
        </div>
        <div class="stat-info">
          <h3>Verilen Teklifler</h3>
          <p class="stat-value">{stats.totalOffers}</p>
        </div>
      </div>

      <!-- Stat Card -->
      <div class="stat-card">
        <div class="stat-icon site-icon">
          <i class="fa-solid fa-circle-nodes"></i>
        </div>
        <div class="stat-info">
          <h3>Aktif Hizmetler</h3>
          <p class="stat-value">{stats.totalSites}</p>
        </div>
      </div>

    </section>

    <!-- En Popüler Hizmetler -->
    <section class="popular-services-section">
      <div class="section-header">
        <h2><i class="fa-solid fa-fire text-orange-400"></i> En Popüler Hizmetler</h2>
        <a href="/admin/settings" class="section-link">Düzenle <i class="fa-solid fa-pen-to-square"></i></a>
      </div>
      <div class="popular-grid">
        {popularServices.length > 0 ? popularServices.slice(0,5).map((svc: any, idx: number) => (
          <div class="popular-card">
            <div class="popular-rank">#{idx + 1}</div>
            <div class="popular-icon"><i class={svc.icon || 'fa-solid fa-star'}></i></div>
            <div class="popular-info">
              <strong>{svc.name}</strong>
              <span>{svc.category || 'Genel Hizmet'}</span>
            </div>
          </div>
        )) : [
          { name: 'Web Paketleri', icon: 'fa-solid fa-globe', category: 'Dijital Hizmetler' },
          { name: 'Toplu SEO', icon: 'fa-solid fa-magnifying-glass-chart', category: 'Pazarlama' },
          { name: 'Bulut Muhasebe', icon: 'fa-solid fa-cloud', category: 'Yazılım' },
          { name: 'Şirket Kurulumu', icon: 'fa-solid fa-building', category: 'Danışmanlık' },
          { name: 'Hosting', icon: 'fa-solid fa-server', category: 'Altyapı' }
        ].map((svc, idx) => (
          <div class="popular-card">
            <div class="popular-rank">#{idx + 1}</div>
            <div class="popular-icon"><i class={svc.icon}></i></div>
            <div class="popular-info">
              <strong>{svc.name}</strong>
              <span>{svc.category}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 2 Yan Yana Kutu: Aktif Hizmetler + Süresi Bitenler -->
    <div class="two-col-layout">
      
      <!-- Aktif / Son Kurulan Hizmetler -->
      <div class="table-card">
        <div class="card-title-bar">
          <h2><i class="fa-solid fa-circle-check text-teal-500 mr-2"></i>Aktif / Son Kurulan Hizmetler</h2>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Hizmet / Domain</th>
                <th>Müşteri</th>
                <th>Başlangıç</th>
                <th>İşlem</th>
              </tr>
            </thead>
            <tbody>
              {recentSites.map(s => (
                <tr>
                  <td class="font-semibold">
                    <div style="font-size: 0.85rem;">{s.service_type === 'web_sitesi' ? '🌐' : '📦'} {s.service_type}</div>
                    <a href={`http://${s.domain}`} target="_blank" style="font-size: 0.78rem; color:#60a5fa;">{s.domain}</a>
                  </td>
                  <td>{s.owner_name}</td>
                  <td style="font-size:0.8rem; color:#94a3b8;">{formatDate(s.created_at)}</td>
                  <td>
                    <form method="POST" style="display:inline;">
                      <input type="hidden" name="action" value="toggle-service-status" />
                      <input type="hidden" name="site_id" value={s.id} />
                      <input type="hidden" name="current_status" value={s.status} />
                      <button type="submit" class="action-btn suspend">Durdur</button>
                    </form>
                    {s.service_type === 'web_sitesi' && (
                      <>
                        <button type="button" class="action-btn update" data-site-id={s.id} style="margin-left:4px;" onclick="triggerUpdate(this)">
                          <i class="fa-solid fa-arrows-rotate"></i> Güncelle
                        </button>
                        <button type="button" class="action-btn migrate" data-site-id={s.id} style="margin-left:4px;" onclick="triggerDbMigrate(this)" title="Veritabanı şemasını güncelle (eksik kolonları ekle)">
                          <i class="fa-solid fa-database"></i> DB Migrate
                        </button>
                      </>
                    )}
                  </td>
                </tr>
              ))}
              {recentSites.length === 0 && (
                <tr><td colspan="4" class="text-center py-6 text-gray-400">Aktif hizmet bulunamadı.</td></tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Süresi Bitmeye Yakın Hizmetler -->
      <div class="table-card">
        <div class="card-title-bar">
          <h2><i class="fa-solid fa-clock text-orange-500 mr-2"></i>Süresi Bitmeye Yakın Hizmetler</h2>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Hizmet / Domain</th>
                <th>Müşteri</th>
                <th>Bitiş Tarihi</th>
                <th>İşlem</th>
              </tr>
            </thead>
            <tbody>
              {expiringSites.map(s => {
                const daysLeft = s.end_date ? Math.ceil((new Date(s.end_date).getTime() - Date.now()) / 86400000) : null;
                return (
                  <tr>
                    <td class="font-semibold">
                      <div style="font-size: 0.85rem;">{s.service_type === 'web_sitesi' ? '🌐' : '📦'} {s.service_type}</div>
                      <a href={`http://${s.domain}`} target="_blank" style="font-size: 0.78rem; color:#60a5fa;">{s.domain}</a>
                    </td>
                    <td>{s.owner_name}</td>
                    <td>
                      <span style={`font-size:0.82rem; font-weight:700; color: ${daysLeft !== null && daysLeft <= 7 ? '#f87171' : daysLeft !== null && daysLeft <= 14 ? '#fb923c' : '#facc15'};`}>
                        {s.end_date ? formatDate(s.end_date) : '-'}
                        {daysLeft !== null && <span style="display:block; font-size:0.72rem; font-weight:400;">({daysLeft} gün kaldı)</span>}
                      </span>
                    </td>
                    <td>
                      <a href={`/admin/edit-service?id=${s.id}`} class="action-btn activate" style="text-decoration:none;">
                        <i class="fa-solid fa-edit"></i> Uzat
                      </a>
                    </td>
                  </tr>
                );
              })}
              {expiringSites.length === 0 && (
                <tr><td colspan="4" class="text-center py-6 text-gray-400">30 gün içinde bitecek hizmet yok. 🎉</td></tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- Content Sections (Kullanıcılar + API Ayarları) -->
    <div class="tables-layout">
      
      <!-- Son Kayıtlı Kullanıcılar -->
      <div class="table-card">
        <div class="card-title-bar">
          <h2><i class="fa-solid fa-user-plus text-blue-500 mr-2"></i>Son Kayıtlı Kullanıcılar</h2>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Ad Soyad</th>
                <th>E-Posta</th>
                <th>Rol</th>
                <th>Tarih</th>
              </tr>
            </thead>
            <tbody>
              {recentUsers.map(u => (
                <tr>
                  <td class="font-semibold">{u.name}</td>
                  <td>{u.email}</td>
                  <td>
                    {u.is_partner === 1 ? (
                      <span class="role-badge partner">İş Ortağı</span>
                    ) : u.is_partner === 2 ? (
                      <span class="role-badge admin">Yönetici</span>
                    ) : (
                      <span class="role-badge member">Üye</span>
                    )}
                  </td>
                  <td class="text-gray-500">{formatDate(u.created_at)}</td>
                </tr>
              ))}
              {recentUsers.length === 0 && (
                <tr><td colspan="4" class="text-center py-6 text-gray-400">Kayıtlı kullanıcı bulunamadı.</td></tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Column 3: Partner Approval Section (Full width) -->
      <div class="table-card full-width">
        <div class="card-title-bar">
          <h2><i class="fa-solid fa-user-check text-yellow-500 mr-2"></i>İş Ortağı Onay ve Yetkilendirme Paneli</h2>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Ad Soyad / Firma</th>
                <th>E-Posta</th>
                <th>Telefon</th>
                <th>Durum</th>
                <th>İşlem</th>
              </tr>
            </thead>
            <tbody>
              {partnersList.map(p => (
                <tr>
                  <td class="font-semibold">{p.name}</td>
                  <td>{p.email}</td>
                  <td>{p.phone || 'Girilmemiş'}</td>
                  <td>
                    {p.is_approved === 1 ? (
                      <span class="status-tag ACTIVE">ONAYLI</span>
                    ) : (
                      <span class="status-tag PENDING">ONAY BEKLİYOR</span>
                    )}
                  </td>
                  <td>
                    <form method="POST" style="display:inline;">
                      <input type="hidden" name="action" value="toggle-partner-approval" />
                      <input type="hidden" name="partner_id" value={p.id} />
                      <input type="hidden" name="current_approved" value={p.is_approved || 0} />
                      <button type="submit" class={`action-btn ${p.is_approved === 1 ? 'suspend' : 'approve'}`}>
                        {p.is_approved === 1 ? 'Onayı Kaldır' : 'Onayla'}
                      </button>
                    </form>
                  </td>
                </tr>
              ))}
              {partnersList.length === 0 && (
                <tr><td colspan="5" class="text-center py-6 text-gray-400">Kayıtlı iş ortağı bulunamadı.</td></tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Column 4: System Credentials Settings (Full width) -->
      <div class="table-card full-width">
        <div class="card-title-bar">
          <h2><i class="fa-solid fa-key text-rose-500 mr-2"></i>GitHub & Cloudflare API Ayarları</h2>
        </div>
        <form method="POST" class="settings-form" style="display: flex; flex-direction: column; gap: 16px;">
          <input type="hidden" name="action" value="update-system-settings" />
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
              <label style="font-size: 0.82rem; font-weight: 700; color: #cbd5e1;">GitHub Personal Access Token (PAT) *</label>
              <input type="password" name="github_pat" value={settingsMap['github_pat'] || ''} placeholder="ghp_..." required style="background: #0f172a; border: 1px solid #334155; color: #fff; padding: 12px; border-radius: 10px;" />
            </div>
            
            <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
              <label style="font-size: 0.82rem; font-weight: 700; color: #cbd5e1;">Cloudflare Account ID *</label>
              <input type="text" name="cloudflare_account_id" value={settingsMap['cloudflare_account_id'] || ''} placeholder="CF Account ID" required style="background: #0f172a; border: 1px solid #334155; color: #fff; padding: 12px; border-radius: 10px;" />
            </div>
          </div>

          <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
            <label style="font-size: 0.82rem; font-weight: 700; color: #cbd5e1;">Cloudflare API Token *</label>
            <input type="password" name="cloudflare_token" value={settingsMap['cloudflare_token'] || ''} placeholder="CF API Token" required style="background: #0f172a; border: 1px solid #334155; color: #fff; padding: 12px; border-radius: 10px;" />
          </div>

          <button type="submit" class="action-btn approve" style="width: fit-content; padding: 12px 24px; font-size: 0.88rem; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-floppy-disk"></i> API Ayarlarını Kaydet
          </button>
        </form>
      </div>

      <!-- Column 5: Recent Requests (Full width) -- move out of tables-layout -->
    </div> <!-- /.tables-layout close -->

    <!-- Son Hizmet İlanları & Talepleri -->
      <div class="table-card full-width">
        <div class="card-title-bar">
          <h2><i class="fa-solid fa-list-check text-purple-500 mr-2"></i>Son Hizmet İlanları & Talepleri</h2>
          <a href="/admin/all-requests" class="section-link">Tüm Listeyi Gör <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Müşteri</th>
                <th>Hizmet Kategorisi</th>
                <th>Başlık</th>
                <th>Durum</th>
                <th>Tarih</th>
              </tr>
            </thead>
            <tbody>
              {recentRequests.map(r => (
                <tr>
                  <td>#{r.id}</td>
                  <td class="font-semibold">{r.client_name}</td>
                  <td class="text-blue-500 font-semibold">{r.category}</td>
                  <td>{r.title}</td>
                  <td>
                    <span class={`status-tag ${r.status}`}>{r.status}</span>
                  </td>
                  <td class="text-gray-500">{formatDate(r.created_at)}</td>
                </tr>
              ))}
              {recentRequests.length === 0 && (
                <tr><td colspan="6" class="text-center py-6 text-gray-400">Henüz hizmet talebi açılmamış.</td></tr>
              )}
            </tbody>
