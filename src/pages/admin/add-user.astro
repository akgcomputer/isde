---
// src/pages/admin/add-user.astro
import BasicLayout from '../../layouts/BasicLayout.astro';

export const prerender = false; // Sunucu tarafında çalışmalıdır (SSR)

let user = Astro.locals.user;
let debugError: string | null = null;
let successMessage: string | null = null;

try {
  if (!Astro.locals.user || Astro.locals.user.is_partner !== 2) {
    return Astro.redirect('/login?error=unauthorized');
  }

  const runtime = Astro.locals.runtime as any;
  const db = runtime?.env?.DB;

  if (Astro.request.method === 'POST') {
    const formData = await Astro.request.formData();
    const name = formData.get('name')?.toString().trim();
    const emailInput = formData.get('email')?.toString().trim();
    const phone = formData.get('phone')?.toString().trim();
    const passwordInput = formData.get('password')?.toString();
    const role = formData.get('role')?.toString() || 'member';
    const isApproved = formData.get('is_approved') ? 1 : 0;

    if (!name || !phone) {
      debugError = "Ad Soyad ve Telefon alanları zorunludur.";
    } else if (!db) {
      debugError = "Veritabanı bağlantısı kurulamadı.";
    } else {
      // Çakışma Kontrolü
      let existing = await db.prepare("SELECT * FROM users WHERE phone = ?").bind(phone).first();
      if (existing) {
        debugError = "Bu telefon numarasıyla kayıtlı bir kullanıcı zaten var.";
      } else {
        const email = emailInput || `${phone}@isdeyeter.com`;
        if (emailInput) {
          existing = await db.prepare("SELECT * FROM users WHERE email = ?").bind(emailInput).first();
        }
        if (existing) {
          debugError = "Bu e-posta adresiyle kayıtlı bir kullanıcı zaten var.";
        } else {
          // Hızlı ekleme
          const newUserId = `admin-added-${crypto.randomUUID()}`;
          const isPartnerValue = role === 'partner' ? 1 : role === 'admin' ? 2 : 0;
          const password = passwordInput || '123456';

          await db.prepare(`
            INSERT INTO users (id, email, name, is_partner, is_approved, phone, password)
            VALUES (?, ?, ?, ?, ?, ?, ?)
          `).bind(newUserId, email, name, isPartnerValue, isApproved, phone, password).run();

          successMessage = `${name} isimli kullanıcı başarıyla kaydedildi.`;
          // Hizmet başlatma sayfasından gelindiyse oraya geri yönlendir
          const redirectUrl = Astro.url.searchParams.get('from') === 'start-service' ? '/admin/start-service' : '/admin';
          return Astro.redirect(`${redirectUrl}?success=${encodeURIComponent(successMessage)}`);
        }
      }
    }
  }
} catch (err: any) {
  console.error("Add User page error:", err);
  debugError = `Beklenmedik Hata: ${err.message}`;
}
---

<BasicLayout title="Yeni Kullanıcı Ekle | Yönetici" description="Sisteme yeni üye veya iş ortağı kaydet.">
  <div class="add-user-wrapper">
    
    <header class="admin-header">
      <div class="header-left">
        <a href="/admin" class="back-link"><i class="fa-solid fa-arrow-left"></i> Kontrol Paneline Dön</a>
        <h1>Yeni Kullanıcı Ekle</h1>
      </div>
    </header>

    {debugError && (
      <div class="error-banner">
        <i class="fa-solid fa-triangle-exclamation mr-2"></i> {debugError}
      </div>
    )}

    <div class="form-card">
      <form method="POST" class="add-user-form">
        
        <div class="form-group">
          <label for="name">Ad Soyad / Firma Adı *</label>
          <input type="text" id="name" name="name" required placeholder="Örn: Ahmet Yılmaz veya Yılmaz Tadilat" />
        </div>

        <div class="form-group">
          <label for="phone">Telefon Numarası *</label>
          <input type="tel" id="phone" name="phone" required placeholder="Örn: 5321234567" />
        </div>

        <div class="form-group">
          <label for="email">E-Posta Adresi (Opsiyonel)</label>
          <input type="email" id="email" name="email" placeholder="Boş bırakılırsa otomatik üretilir" />
        </div>

        <div class="form-group">
          <label for="password">Şifre (Opsiyonel)</label>
          <input type="text" id="password" name="password" placeholder="Varsayılan: 123456" />
        </div>

        <div class="form-group">
          <label for="role">Kullanıcı Rolü</label>
          <select id="role" name="role" class="form-select">
            <option value="member">Üye (Müşteri - Hizmet Alan)</option>
            <option value="partner">İş Ortağı (Hizmet Veren / Usta)</option>
            <option value="admin">Sistem Yöneticisi (Admin)</option>
          </select>
        </div>

        <div class="form-group checkbox-group" id="approval-group">
          <label class="checkbox-label">
            <input type="checkbox" name="is_approved" checked value="1" />
            <span>İş Ortağı Onaylı Başlasın (Teklif havuzunu görebilir)</span>
          </label>
        </div>

        <button type="submit" class="save-btn">
          <i class="fa-solid fa-floppy-disk"></i> Kullanıcıyı Sisteme Kaydet
        </button>

      </form>
    </div>

  </div>

  <script>
    // Rol partner olmadığında onay kutusunu göster/gizle
    const roleSelect = document.getElementById('role') as HTMLSelectElement;
    const approvalGroup = document.getElementById('approval-group') as HTMLDivElement;

    if (roleSelect && approvalGroup) {
      roleSelect.addEventListener('change', () => {
        if (roleSelect.value === 'partner') {
          approvalGroup.style.display = 'block';
        } else {
          approvalGroup.style.display = 'none';
        }
      });
      // İlk yükleme tetikleme
      if (roleSelect.value !== 'partner') {
        approvalGroup.style.display = 'none';
      }
    }
  </script>

  <style>
    .add-user-wrapper {
      background: #0f172a;
      min-height: 100vh;
      color: #e2e8f0;
      padding: 40px 20px;
      display: flex;
      flex-direction: column;
      gap: 32px;
      font-family: 'Inter', sans-serif;
      align-items: center;
    }

    .admin-header {
      background: #1e293b;
      border: 1px solid #334155;
      padding: 24px 32px;
      border-radius: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
      max-width: 600px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .back-link {
      color: #3b82f6;
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: color 0.2s;
    }

    .back-link:hover {
      color: #60a5fa;
    }

    .admin-header h1 {
      font-size: 1.6rem;
      color: #ffffff;
      font-weight: 800;
    }

    .error-banner {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid #ef4444;
      padding: 16px;
      border-radius: 12px;
      color: #f87171;
      width: 100%;
      max-width: 600px;
      font-size: 0.9rem;
    }

    .form-card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 20px;
      padding: 32px;
      width: 100%;
      max-width: 600px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .add-user-form {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group label {
      font-size: 0.88rem;
      font-weight: 600;
      color: #94a3b8;
    }

    .form-group input, .form-select {
      background: #0f172a;
      border: 1px solid #334155;
      color: #ffffff;
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 0.95rem;
      transition: all 0.2s;
    }

    .form-group input:focus, .form-select:focus {
      border-color: #3b82f6;
      outline: none;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }

    .checkbox-group {
      margin-top: 4px;
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      font-size: 0.9rem;
      color: #cbd5e1;
    }

    .checkbox-label input {
      width: 18px;
      height: 18px;
      cursor: pointer;
    }

    .save-btn {
      background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
      color: #ffffff;
      padding: 14px;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 700;
      border: none;
      cursor: pointer;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
      box-shadow: 0 4px 15px rgba(59, 130, 246, 0.2);
    }

    .save-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(59, 130, 246, 0.3);
    }
  </style>
</BasicLayout>
