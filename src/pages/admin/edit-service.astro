---
// src/pages/admin/edit-service.astro
import BasicLayout from '../../layouts/BasicLayout.astro';

export const prerender = false; // Sunucu tarafında çalışmalıdır (SSR)

let user = Astro.locals.user;
let debugError: string | null = null;
let successMessage: string | null = null;
let service: any = null;

const serviceId = Astro.url.searchParams.get('id');

try {
  if (!Astro.locals.user || Astro.locals.user.is_partner !== 2) {
    return Astro.redirect('/login?error=unauthorized');
  }

  const runtime = Astro.locals.runtime as any;
  const db = runtime?.env?.DB;

  if (!db) {
    debugError = "Veritabanı bağlantısı kurulamadı.";
  } else if (!serviceId) {
    debugError = "Hizmet kimliği belirtilmedi.";
  } else {
    // Hizmeti getir
    service = await db.prepare(
      "SELECT s.*, u.name as owner_name, u.email as owner_email FROM sites s JOIN users u ON s.user_id = u.id WHERE s.id = ?"
    ).bind(serviceId).first();

    if (!service) {
      debugError = "Düzenlenmek istenen hizmet veritabanında bulunamadı.";
    }

    // Form POST Edildiğinde
    if (Astro.request.method === 'POST') {
      const formData = await Astro.request.formData();
      const domain = (formData.get('domain') as string || '').trim().toLowerCase();
      const serviceType = formData.get('service_type') as string;
      const mode = formData.get('mode') as string || 'hizmet';
      const status = formData.get('status') as string || 'ACTIVE';
      const startDate = formData.get('start_date') as string || null;
      const endDate = formData.get('end_date') as string || null;

      if (!domain) {
        debugError = "Alan adı (domain) alanı zorunludur.";
      } else {
        // Çakışma Kontrolü (kendi ID'si hariç)
        const checkConflict = await db.prepare("SELECT * FROM sites WHERE domain = ? AND id != ?").bind(domain, serviceId).first();
        if (checkConflict) {
          debugError = `'${domain}' alan adı zaten başka bir hizmete atanmış.`;
        } else {
          await db.prepare(`
            UPDATE sites 
            SET domain = ?, service_type = ?, mode = ?, status = ?, start_date = ?, end_date = ?
            WHERE id = ?
          `).bind(domain, serviceType, mode, status, startDate, endDate, serviceId).run();

          successMessage = "Hizmet ayarları başarıyla güncellendi.";
          
          // Hizmeti yeniden çek
          service = await db.prepare(
            "SELECT s.*, u.name as owner_name, u.email as owner_email FROM sites s JOIN users u ON s.user_id = u.id WHERE s.id = ?"
          ).bind(serviceId).first();
        }
      }
    }
  }
} catch (err: any) {
  console.error("Edit Service page error:", err);
  debugError = `Hata oluştu: ${err.message}`;
}
---

<BasicLayout title="Hizmet Düzenle | Yönetici" description="Kullanıcı hizmeti ayarlarını ve süre limitlerini güncelle.">
  <div class="edit-service-wrapper">
    
    <header class="admin-header">
      <div class="header-left">
        <a href="/admin" class="back-link"><i class="fa-solid fa-arrow-left"></i> Kontrol Paneline Dön</a>
        <h1>Hizmet Ayarlarını Düzenle</h1>
      </div>
    </header>

    {debugError && (
      <div class="error-banner">
        <i class="fa-solid fa-triangle-exclamation mr-2"></i> {debugError}
      </div>
    )}

    {successMessage && (
      <div class="success-banner">
        <i class="fa-solid fa-circle-check mr-2"></i> {successMessage}
      </div>
    )}

    {service && (
      <div class="form-card">
        
        <div class="service-owner-info">
          <h3>Müşteri / Sahibi</h3>
          <p><strong>{service.owner_name}</strong> ({service.owner_email})</p>
        </div>

        <form method="POST" class="edit-service-form">
          
          <div class="form-group">
            <label for="domain">Alan Adı (Domain) *</label>
            <input 
              type="text" 
              id="domain" 
              name="domain" 
              required 
              value={service.domain} 
              placeholder="Örn: sirketiniz.com"
            />
          </div>

          <div class="form-group">
            <label for="service_type">Hizmet Tipi</label>
            <select id="service_type" name="service_type" class="form-select">
              <option value="web_sitesi" selected={service.service_type === 'web_sitesi'}>🌐 Web Sitesi Kurulumu</option>
              <option value="muhasebe_paketi" selected={service.service_type === 'muhasebe_paketi'}>📊 Ön Muhasebe Paketi</option>
              <option value="eticaret_paketi" selected={service.service_type === 'eticaret_paketi'}>🛍️ E-Ticaret Yönetim Paneli</option>
              <option value="diger_hizmet" selected={service.service_type === 'diger_hizmet'}>⚙️ Diğer Özel Hizmetler</option>
            </select>
          </div>

          <div class="form-group">
            <label for="mode">Açılış / Çalışma Modu</label>
            <select id="mode" name="mode" class="form-select">
              <option value="hizmet" selected={service.mode === 'hizmet'}>💼 Hizmet / Portfolyo Modu</option>
              <option value="urun" selected={service.mode === 'urun'}>📦 Ürün / Katalog Satış Modu</option>
            </select>
          </div>

          <div class="form-group">
            <label for="status">Durum</label>
            <select id="status" name="status" class="form-select">
              <option value="ACTIVE" selected={service.status === 'ACTIVE'}>🟢 Aktif (Yayında)</option>
              <option value="PASSIVE" selected={service.status === 'PASSIVE'}>🔴 Pasif (Askıda/Süresi Dolmuş)</option>
              <option value="PENDING" selected={service.status === 'PENDING'}>⏳ Beklemede (Kurulum Kuyruğunda)</option>
            </select>
          </div>

          <div class="dates-row">
            <div class="form-group">
              <label for="start_date">Başlangıç Tarihi</label>
              <input 
                type="date" 
                id="start_date" 
                name="start_date" 
                value={service.start_date ? service.start_date.split('T')[0] : ''} 
              />
            </div>
            <div class="form-group">
              <label for="end_date">Bitiş Tarihi</label>
              <input 
                type="date" 
                id="end_date" 
                name="end_date" 
                value={service.end_date ? service.end_date.split('T')[0] : ''} 
              />
            </div>
          </div>

          <button type="submit" class="save-btn">
            <i class="fa-solid fa-floppy-disk"></i> Değişiklikleri Güncelle
          </button>

        </form>
      </div>
    )}

  </div>

  <style>
    .edit-service-wrapper {
      background: #0f172a;
      min-height: 100vh;
      color: #e2e8f0;
      padding: 40px 20px;
      display: flex;
      flex-direction: column;
      gap: 32px;
      font-family: 'Inter', sans-serif;
      align-items: center;
    }

    .admin-header {
      background: #1e293b;
      border: 1px solid #334155;
      padding: 24px 32px;
      border-radius: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
      max-width: 600px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .back-link {
      color: #3b82f6;
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: color 0.2s;
    }

    .back-link:hover {
      color: #60a5fa;
    }

    .admin-header h1 {
      font-size: 1.6rem;
      color: #ffffff;
      font-weight: 800;
    }

    .error-banner {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid #ef4444;
      padding: 16px;
      border-radius: 12px;
      color: #f87171;
      width: 100%;
      max-width: 600px;
      font-size: 0.9rem;
    }

    .success-banner {
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid #10b981;
      padding: 16px;
      border-radius: 12px;
      color: #34d399;
      width: 100%;
      max-width: 600px;
      font-size: 0.9rem;
    }

    .form-card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 20px;
      padding: 32px;
      width: 100%;
      max-width: 600px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .service-owner-info {
      background: #0f172a;
      border: 1px solid #334155;
      padding: 16px 20px;
      border-radius: 12px;
    }

    .service-owner-info h3 {
      font-size: 0.82rem;
      color: #64748b;
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .service-owner-info p {
      font-size: 0.95rem;
      color: #ffffff;
      margin: 0;
    }

    .edit-service-form {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group label {
      font-size: 0.88rem;
      font-weight: 600;
      color: #94a3b8;
    }

    .form-group input, .form-select {
      background: #0f172a;
      border: 1px solid #334155;
      color: #ffffff;
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 0.95rem;
      transition: all 0.2s;
    }

    .form-group input:focus, .form-select:focus {
      border-color: #3b82f6;
      outline: none;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }

    .dates-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .save-btn {
      background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
      color: #ffffff;
      padding: 14px;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 700;
      border: none;
      cursor: pointer;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
      box-shadow: 0 4px 15px rgba(59, 130, 246, 0.2);
    }

    .save-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(59, 130, 246, 0.3);
    }
  </style>
</BasicLayout>
