---
// src/pages/admin/start-service.astro
import BasicLayout from '../../layouts/BasicLayout.astro';

export const prerender = false; // Sunucu tarafında çalışmalıdır (SSR)

let user = Astro.locals.user;
let debugError: string | null = null;
let successMessage: string | null = null;
let usersData: string = "[]";

try {
  if (!Astro.locals.user || Astro.locals.user.is_partner !== 2) {
    return Astro.redirect('/login?error=unauthorized');
  }

  const runtime = Astro.locals.runtime as any;
  const db = runtime?.env?.DB;

  if (!db) {
    debugError = "Veritabanı bağlantısı kurulamadı.";
  } else {
    // Tüm kullanıcıları getir (Arama/Seçim için)
    const usersQuery = await db.prepare("SELECT id, name, email, phone, is_partner FROM users ORDER BY name ASC").all();
    usersData = JSON.stringify(usersQuery.results || []);

    // Form POST Edildiğinde (Kurulum Tamamlandığında)
    if (Astro.request.method === 'POST') {
      try {
        const formData = await Astro.request.formData();
        const selectedUserId = formData.get('user_id') as string;
        const serviceType = formData.get('service_type') as string;
        const duration = formData.get('duration') as string;
        const startDate = formData.get('start_date') as string;
        const endDate = formData.get('end_date') as string;
        const domain = (formData.get('domain') as string || '').trim().toLowerCase();
        const mode = formData.get('mode') as string || 'hizmet';

        if (!selectedUserId) {
          throw new Error("Lütfen bir kullanıcı seçin.");
        }
        if (!serviceType) {
          throw new Error("Lütfen bir hizmet seçin.");
        }

        // Domain kontrolü (Web Sitesi için)
        if (serviceType === 'web_sitesi') {
          if (!domain) {
            throw new Error("Web sitesi hizmeti için alan adı (domain) zorunludur.");
          }
          // Alt alan adı (subdomain) kontrolü: İki veya daha fazla nokta varsa (com.tr / org.tr istisnası ile)
          const dotCount = (domain.match(/\./g) || []).length;
          const isTrExtension = domain.endsWith('.com.tr') || domain.endsWith('.net.tr') || domain.endsWith('.org.tr');
          if ((dotCount > 1 && !isTrExtension) || (dotCount > 2 && isTrExtension)) {
            throw new Error("Web paketleri sadece ana alan adı (domain) için kurulabilir. Alt alan adı (subdomain) girilemez!");
          }

          // Domain çakışma kontrolü
          const existingDomain = await db.prepare("SELECT * FROM sites WHERE domain = ?").bind(domain).first();
          if (existingDomain) {
            throw new Error(`'${domain}' alan adı zaten başka bir hizmet için tanımlanmış.`);
          }
        }

        // D1 veritabanına kaydet
        // Tabloda domain UNIQUE NOT NULL olduğundan, web sitesi dışındaki hizmetler için geçici/tekil bir kimlik üretiyoruz.
        const finalDomain = serviceType === 'web_sitesi' ? domain : `${serviceType}-${crypto.randomUUID().slice(0, 8)}.internal`;

        await db.prepare(`
          INSERT INTO sites (user_id, domain, mode, status, service_type, start_date, end_date)
          VALUES (?, ?, ?, ?, ?, ?, ?)
        `).bind(
          selectedUserId,
          finalDomain,
          mode,
          'ACTIVE', // Kurulum tamamlandığı için aktif
          serviceType,
          startDate || null,
          endDate || null
        ).run();

        return Astro.redirect('/admin?success=' + encodeURIComponent(`${serviceType === 'web_sitesi' ? 'Web sitesi' : 'Hizmet'} kurulumu başarıyla tamamlandı ve aktif edildi.`));
      } catch (err: any) {
        console.error("Save service error:", err);
        debugError = err.message;
      }
    }
  }
} catch (globalErr: any) {
  console.error("Start Service page error:", globalErr);
  debugError = `Beklenmedik Hata: ${globalErr.message}`;
}
---

<BasicLayout title="Yeni Hizmet Başlat | Yönetici" description="Kullanıcılar için GitHub ve Cloudflare altyapılı yeni hizmet/web sitesi başlat.">
  <div class="wizard-wrapper">
    
    <header class="admin-header">
      <div class="header-left">
        <a href="/admin" class="back-link"><i class="fa-solid fa-arrow-left"></i> Kontrol Paneline Dön</a>
        <h1>Hizmet Başlatma Sihirbazı</h1>
      </div>
      <div class="wizard-steps-indicator">
        <div class="step-indicator active" id="ind-1">1. Müşteri</div>
        <div class="step-indicator" id="ind-2">2. Hizmet & Süre</div>
        <div class="step-indicator" id="ind-3">3. Domain / Detay</div>
        <div class="step-indicator" id="ind-4">4. Otomatik Kurulum</div>
      </div>
    </header>

    {debugError && (
      <div class="error-banner">
        <i class="fa-solid fa-triangle-exclamation mr-2"></i> {debugError}
      </div>
    )}

    <div class="wizard-card">
      <form method="POST" id="wizard-form" novalidate>
        
        <!-- STEP 1: SELECT USER -->
        <div class="wizard-step active" id="step-1">
          <h2><i class="fa-solid fa-user-circle mr-2"></i> Adım 1: Kullanıcı / Müşteri Seçimi</h2>
          <p class="step-desc">Hizmetin atanacağı üyeyi arayarak seçin. Aradığınız kullanıcı listede yoksa yeni bir kullanıcı ekleyebilirsiniz.</p>
          
          <div class="search-container">
            <div class="search-input-wrapper">
              <i class="fa-solid fa-search search-icon"></i>
              <input type="text" id="user-search" placeholder="İsim, e-posta veya telefon ile arayın..." autocomplete="off" />
            </div>
            <div class="search-results" id="search-results"></div>
          </div>

          <div class="selected-user-card" id="selected-user-card" style="display: none;">
            <div class="user-card-header">
              <i class="fa-solid fa-user-check checked-icon"></i>
              <div>
                <h4 id="sel-user-name"></h4>
                <p id="sel-user-email"></p>
                <p id="sel-user-phone"></p>
                <span class="role-badge" id="sel-user-role"></span>
              </div>
            </div>
            <input type="hidden" name="user_id" id="hidden-user-id" />
          </div>

          <div class="quick-add-box">
            <span>Aradığınız kullanıcıyı bulamadınız mı?</span>
            <a href="/admin/add-user?from=start-service" class="quick-add-link">
              <i class="fa-solid fa-user-plus"></i> Hızlıca Yeni Kullanıcı Ekle
            </a>
          </div>

          <div class="wizard-actions">
            <button type="button" class="btn-next" id="btn-to-2" disabled>İleri: Hizmet Seçimi <i class="fa-solid fa-arrow-right"></i></button>
          </div>
        </div>

        <!-- STEP 2: SELECT SERVICE & DURATION -->
        <div class="wizard-step" id="step-2">
          <h2><i class="fa-solid fa-cubes mr-2"></i> Adım 2: Hizmet Tipi & Süre Sınırı</h2>
          <p class="step-desc">Kullanıcıya atanacak hizmet tipini belirleyin ve kullanım süresini ayarlayın.</p>

          <div class="form-group">
            <label for="service_type">Hizmet Tipi</label>
            <select id="service_type" name="service_type" class="form-select">
              <option value="web_sitesi">🌐 Web Sitesi Kurulumu (akgcomputer/laflaf)</option>
              <option value="muhasebe_paketi">📊 Ön Muhasebe Paketi</option>
              <option value="eticaret_paketi">🛍️ E-Ticaret Yönetim Paneli</option>
              <option value="diger_hizmet">⚙️ Diğer Özel Hizmetler</option>
            </select>
          </div>

          <div class="form-group">
            <label>Hizmet Süresi</label>
            <div class="duration-buttons">
              <button type="button" class="duration-btn" data-val="1_ay">1 Ay</button>
              <button type="button" class="duration-btn active" data-val="1_yil">1 Yıl (Önerilen)</button>
              <button type="button" class="duration-btn" data-val="ozel">Özel Seçim</button>
            </div>
            <input type="hidden" name="duration" id="hidden-duration" value="1_yil" />
          </div>

          <div class="dates-row">
            <div class="form-group">
              <label for="start_date">Başlangıç Tarihi</label>
              <input type="date" id="start_date" name="start_date" required />
            </div>
            <div class="form-group">
              <label for="end_date">Bitiş Tarihi</label>
              <input type="date" id="end_date" name="end_date" required />
            </div>
          </div>

          <div class="wizard-actions">
            <button type="button" class="btn-prev" id="btn-back-1"><i class="fa-solid fa-arrow-left"></i> Geri</button>
            <button type="button" class="btn-next" id="btn-to-3">İleri: Domain Tanımı <i class="fa-solid fa-arrow-right"></i></button>
          </div>
        </div>

        <!-- STEP 3: DOMAIN & MODE -->
        <div class="wizard-step" id="step-3">
          <h2><i class="fa-solid fa-globe mr-2"></i> Adım 3: Alan Adı (Domain) ve Çalışma Modu</h2>
          <p class="step-desc">Web sitenizin kurulacağı alan adını ve başlangıç çalışma modunu yapılandırın.</p>

          <div class="form-group" id="domain-group">
            <label for="domain">Alan Adı (Domain) *</label>
            <input type="text" id="domain" name="domain" placeholder="Örn: sirketiniz.com" autocomplete="off" />
            <span class="input-hint">Önemli: Alt alan adı (subdomain) eklenemez. Sadece ana alan adı (domain) girişi yapın.</span>
            <div class="domain-error" id="domain-validation-error" style="display: none; color: #f87171; font-size: 0.82rem; margin-top: 6px;"></div>
          </div>

          <div class="form-group">
            <label for="mode">Açılış Modu</label>
            <select id="mode" name="mode" class="form-select">
              <option value="hizmet">💼 Hizmet / Portfolyo Modu</option>
              <option value="urun">📦 Ürün / Katalog Satış Modu</option>
            </select>
          </div>

          <div class="wizard-actions">
            <button type="button" class="btn-prev" id="btn-back-2"><i class="fa-solid fa-arrow-left"></i> Geri</button>
            <button type="button" class="btn-next" id="btn-to-4">İleri: Kurulumu Başlat <i class="fa-solid fa-arrow-right"></i></button>
          </div>
        </div>

        <!-- STEP 4: PROVISIONING SIMULATOR -->
        <div class="wizard-step" id="step-4">
          <h2><i class="fa-solid fa-rocket mr-2"></i> Adım 4: Bulut Hizmetleri Otomatik Yapılandırma</h2>
          <p class="step-desc">Kurulum başlatıldığında GitHub kaynak kodumuzdan projeyi çekip, Cloudflare altyapısında Pages, D1 Database ve R2 Storage servislerini oluşturacağız.</p>

          <div class="setup-summary">
            <h4>Kurulum Özeti</h4>
            <div class="summary-details">
              <div><strong>Kullanıcı:</strong> <span id="sum-user"></span></div>
              <div><strong>Hizmet Tipi:</strong> <span id="sum-service"></span></div>
              <div><strong>Domain / Adres:</strong> <span id="sum-domain"></span></div>
              <div><strong>Bitiş Tarihi:</strong> <span id="sum-date"></span></div>
            </div>
          </div>

          <!-- Provisioning Steps List -->
          <div class="provisioning-progress" style="display: none;">
            <div class="prov-step" id="prov-1">
              <div class="prov-status"><i class="fa-solid fa-circle-notch fa-spin"></i></div>
              <div class="prov-text">GitHub deposu hazırlanıyor (akgcomputer/laflaf)</div>
            </div>
            <div class="prov-step pending" id="prov-2">
              <div class="prov-status"><i class="fa-solid fa-circle"></i></div>
              <div class="prov-text">Cloudflare Pages Projesi oluşturuluyor</div>
            </div>
            <div class="prov-step pending" id="prov-3">
              <div class="prov-status"><i class="fa-solid fa-circle"></i></div>
              <div class="prov-text">Cloudflare D1 SQL Veritabanı oluşturuluyor ve bağlanıyor</div>
            </div>
            <div class="prov-step pending" id="prov-4">
              <div class="prov-status"><i class="fa-solid fa-circle"></i></div>
              <div class="prov-text">Cloudflare R2 Bucket depolama alanı oluşturuluyor</div>
            </div>
            <div class="prov-step pending" id="prov-5">
              <div class="prov-status"><i class="fa-solid fa-circle"></i></div>
              <div class="prov-text">Site ayarları veritabanı tohumlaması (Seed) yapılıyor</div>
            </div>
            <div class="prov-step pending" id="prov-6">
              <div class="prov-status"><i class="fa-solid fa-circle"></i></div>
              <div class="prov-text">Astro projesi Pages Edge CDN üzerinde yayına alınıyor</div>
            </div>
            <div class="prov-step pending" id="prov-7">
              <div class="prov-status"><i class="fa-solid fa-circle"></i></div>
              <div class="prov-text">Web sitesi aktiflik ve SSL bağlantı doğrulaması çalışıyor</div>
            </div>
          </div>

          <div class="terminal-logs" id="terminal-logs" style="display: none;">
            <div class="logs-header">TERMINAL DEPLOYMENT LOGS</div>
            <div class="logs-body" id="logs-body"></div>
          </div>

          <div class="wizard-actions">
            <button type="button" class="btn-prev" id="btn-back-3"><i class="fa-solid fa-arrow-left"></i> Geri</button>
            <button type="button" class="start-prov-btn" id="btn-start-provisioning">
              <i class="fa-solid fa-play"></i> Kurulumu Başlat (Otomatik Deploy)
            </button>
            <button type="submit" class="finish-btn" id="btn-finish-wizard" style="display: none;">
              <i class="fa-solid fa-check-circle"></i> Kurulumu Bitir & Hizmeti Aktifleştir
            </button>
          </div>
        </div>

      </form>
    </div>

  </div>

  <script define:vars={{ usersData }}>
    // Kullanıcılar JSON verisini çöz
    const allUsers = JSON.parse(usersData);

    // DOM Elemanları
    const indicators = {
      1: document.getElementById('ind-1'),
      2: document.getElementById('ind-2'),
      3: document.getElementById('ind-3'),
      4: document.getElementById('ind-4'),
    };

    const steps = {
      1: document.getElementById('step-1'),
      2: document.getElementById('step-2'),
      3: document.getElementById('step-3'),
      4: document.getElementById('step-4'),
    };

    let currentStep = 1;

    function navigateToStep(stepNum) {
      // Adımları gizle/göster
      Object.keys(steps).forEach(s => {
        steps[s].classList.remove('active');
        indicators[s].classList.remove('active');
      });
      steps[stepNum].classList.add('active');
      indicators[stepNum].classList.add('active');
      currentStep = stepNum;
    }

    // Step 1: Kullanıcı Arama & Autocomplete
    const userSearch = document.getElementById('user-search');
    const searchResults = document.getElementById('search-results');
    const selectedUserCard = document.getElementById('selected-user-card');
    const hiddenUserId = document.getElementById('hidden-user-id');
    const selName = document.getElementById('sel-user-name');
    const selEmail = document.getElementById('sel-user-email');
    const selPhone = document.getElementById('sel-user-phone');
    const selRole = document.getElementById('sel-user-role');
    const btnTo2 = document.getElementById('btn-to-2');

    userSearch.addEventListener('input', () => {
      const q = userSearch.value.trim().toLowerCase();
      if (!q) {
        searchResults.innerHTML = '';
        return;
      }

      const filtered = allUsers.filter(u => 
        u.name.toLowerCase().includes(q) || 
        u.email.toLowerCase().includes(q) || 
        (u.phone && u.phone.includes(q))
      ).slice(0, 5);

      searchResults.innerHTML = '';
      if (filtered.length === 0) {
        searchResults.innerHTML = '<div class="search-item-empty">Kullanıcı bulunamadı</div>';
      } else {
        filtered.forEach(u => {
          const div = document.createElement('div');
          div.className = 'search-item';
          div.innerHTML = `
            <strong>${u.name}</strong>
            <span class="item-meta">${u.email} | ${u.phone || 'Tel yok'}</span>
          `;
          div.addEventListener('click', () => {
            selectUser(u);
          });
          searchResults.appendChild(div);
        });
      }
    });

    function selectUser(userObj) {
      hiddenUserId.value = userObj.id;
      selName.textContent = userObj.name;
      selEmail.textContent = userObj.email;
      selPhone.textContent = userObj.phone || 'Telefon belirtilmemiş';
      selRole.textContent = userObj.is_partner === 1 ? 'İş Ortağı' : userObj.is_partner === 2 ? 'Admin' : 'Müşteri';
      selRole.className = `role-badge ${userObj.is_partner === 1 ? 'partner' : userObj.is_partner === 2 ? 'admin' : 'member'}`;
      
      selectedUserCard.style.display = 'block';
      searchResults.innerHTML = '';
      userSearch.value = '';
      btnTo2.removeAttribute('disabled');
    }

    // Step 2: Tarih Hesaplayıcı
    const serviceType = document.getElementById('service_type');
    const startInput = document.getElementById('start_date');
    const endInput = document.getElementById('end_date');
    const durationBtn = document.querySelectorAll('.duration-btn');
    const hiddenDuration = document.getElementById('hidden-duration');

    // Tarihleri bugüne göre ayarla
    const today = new Date();
    const formatDateForInput = (d) => {
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    // İlk yükleme varsayılan tarihleri (1 yıl)
    startInput.value = formatDateForInput(today);
    const oneYearLater = new Date();
    oneYearLater.setFullYear(today.getFullYear() + 1);
    endInput.value = formatDateForInput(oneYearLater);

    durationBtn.forEach(btn => {
      btn.addEventListener('click', () => {
        durationBtn.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const val = btn.getAttribute('data-val');
        hiddenDuration.value = val;

        if (val === '1_ay') {
          startInput.value = formatDateForInput(today);
          const oneMonthLater = new Date();
          oneMonthLater.setMonth(today.getMonth() + 1);
          endInput.value = formatDateForInput(oneMonthLater);
          startInput.setAttribute('readonly', 'true');
          endInput.setAttribute('readonly', 'true');
        } else if (val === '1_yil') {
          startInput.value = formatDateForInput(today);
          const oneYear = new Date();
          oneYear.setFullYear(today.getFullYear() + 1);
          endInput.value = formatDateForInput(oneYear);
          startInput.setAttribute('readonly', 'true');
          endInput.setAttribute('readonly', 'true');
        } else {
          // Özel Seçim
          startInput.removeAttribute('readonly');
          endInput.removeAttribute('readonly');
        }
      });
    });

    // Step 3: Domain & Mod ve Gösterim Mantığı
    const domainInput = document.getElementById('domain');
    const domainGroup = document.getElementById('domain-group');
    const domainValError = document.getElementById('domain-validation-error');

    serviceType.addEventListener('change', () => {
      if (serviceType.value === 'web_sitesi') {
        domainGroup.style.display = 'flex';
        domainInput.setAttribute('required', 'true');
      } else {
        domainGroup.style.display = 'none';
        domainInput.removeAttribute('required');
      }
    });

    // Domain validation checker (subdomain engelleme)
    function validateDomain(dom) {
      if (serviceType.value !== 'web_sitesi') return true;
      const clean = dom.trim().toLowerCase();
      if (!clean) return false;

      // Basit domain regex
      const domainRegex = /^[a-z0-9]+([\-\.]{1}[a-z0-9]+)*\.[a-z]{2,5}$/;
      if (!domainRegex.test(clean)) {
        return "Geçersiz alan adı formatı (Örn: firmaniz.com)";
      }

      // Nokta sayısı kontrolü
      const dots = (clean.match(/\./g) || []).length;
      const isTr = clean.endsWith('.com.tr') || clean.endsWith('.net.tr') || clean.endsWith('.org.tr');
      if ((dots > 1 && !isTr) || (dots > 2 && isTr)) {
        return "Yalnızca ana domain formatında kurulum yapılabilir. Alt alan adı (subdomain) yasaktır!";
      }

      return true;
    }

    // Step 4: Kurulum Özeti & Simülasyon
    const sumUser = document.getElementById('sum-user');
    const sumService = document.getElementById('sum-service');
    const sumDomain = document.getElementById('sum-domain');
    const sumDate = document.getElementById('sum-date');

    // Navigasyon Olayları
    document.getElementById('btn-to-2').addEventListener('click', () => navigateToStep(2));
    document.getElementById('btn-back-1').addEventListener('click', () => navigateToStep(1));
    
    document.getElementById('btn-to-3').addEventListener('click', () => {
      // Step 3'e geçiş
      navigateToStep(3);
    });
    
    document.getElementById('btn-back-2').addEventListener('click', () => navigateToStep(2));
    
    document.getElementById('btn-to-4').addEventListener('click', () => {
      // Alan adı doğrula (Eğer Web Sitesi ise)
      if (serviceType.value === 'web_sitesi') {
        const dom = domainInput.value.trim();
        const check = validateDomain(dom);
        if (check !== true) {
          domainValError.textContent = check || "Alan adı hatası.";
          domainValError.style.display = 'block';
          domainInput.classList.add('error');
          return;
        }
      }
      domainValError.style.display = 'none';
      domainInput.classList.remove('error');

      // Özeti doldur
      sumUser.textContent = selName.textContent;
      sumService.textContent = serviceType.options[serviceType.selectedIndex].text;
      sumDomain.textContent = serviceType.value === 'web_sitesi' ? domainInput.value.trim() : 'Hizmete özel iç domain';
      sumDate.textContent = endInput.value;

      navigateToStep(4);
    });

    document.getElementById('btn-back-3').addEventListener('click', () => navigateToStep(3));

    // REAL AUTOMATED PROVISIONING LOGIC
    const btnStartProv = document.getElementById('btn-start-provisioning');
    const btnFinish = document.getElementById('btn-finish-wizard');
    const btnBack3 = document.getElementById('btn-back-3');
    const provProgress = document.querySelector('.provisioning-progress');
    const terminalLogs = document.getElementById('terminal-logs');
    const logsBody = document.getElementById('logs-body');

    const provSteps = [
      document.getElementById('prov-1'),
      document.getElementById('prov-2'),
      document.getElementById('prov-3'),
      document.getElementById('prov-4'),
      document.getElementById('prov-5'),
      document.getElementById('prov-6'),
      document.getElementById('prov-7')
    ];

    btnStartProv.addEventListener('click', () => {
      btnStartProv.style.display = 'none';
      btnBack3.style.display = 'none';
      provProgress.style.display = 'flex';
      terminalLogs.style.display = 'block';

      runActualProvisioning();
    });

    function addLogLine(text, type = 'info') {
      const p = document.createElement('p');
      p.className = `log-line ${type}`;
      const time = new Date().toLocaleTimeString('tr-TR');
      p.innerHTML = `<span class="log-time">[${time}]</span> ${text}`;
      logsBody.appendChild(p);
      logsBody.scrollTop = logsBody.scrollHeight;
    }

    async function runActualProvisioning() {
      const domainVal = domainInput.value.trim() || 'internal-service';
      const serviceTypeVal = serviceType.value;
      let d1Uuid = '';

      try {
        // Adım 1: GitHub Repo
        addLogLine(">> GitHub deposu oluşturuluyor: akgcomputer/laflaf şablonu kopyalanıyor...", 'command');
        let res = await fetch('/api/admin/provision', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ step: 1, domain: domainVal, service_type: serviceTypeVal })
        });
        let data = await res.json();
        if (!res.ok) throw new Error(data.error || "GitHub deposu oluşturulamadı.");
        addLogLine(`GitHub: ${data.message}`, 'success');
        markStepSuccess(0);

        // Adım 2: Cloudflare Pages
        provSteps[1].className = 'prov-step';
        provSteps[1].querySelector('.prov-status').innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';
        addLogLine(">> Cloudflare Pages projesi tanımlanıyor...", 'command');
        res = await fetch('/api/admin/provision', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ step: 2, domain: domainVal, service_type: serviceTypeVal })
        });
        data = await res.json();
        if (!res.ok) throw new Error(data.error || "Pages projesi oluşturulamadı.");
        addLogLine(`CF Pages: ${data.message}`, 'success');
        markStepSuccess(1);

        // Adım 3: D1 Database
        provSteps[2].className = 'prov-step';
        provSteps[2].querySelector('.prov-status').innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';
        addLogLine(">> Cloudflare D1 veritabanı tahsis ediliyor...", 'command');
        res = await fetch('/api/admin/provision', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ step: 3, domain: domainVal, service_type: serviceTypeVal })
        });
        data = await res.json();
        if (!res.ok) throw new Error(data.error || "D1 veritabanı oluşturulamadı.");
        d1Uuid = data.d1_uuid;
        addLogLine(`CF D1: ${data.message}`, 'success');
        markStepSuccess(2);

        // Adım 4: R2 Bucket
        provSteps[3].className = 'prov-step';
        provSteps[3].querySelector('.prov-status').innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';
        addLogLine(">> Cloudflare R2 Bucket depolama alanı açılıyor...", 'command');
        res = await fetch('/api/admin/provision', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ step: 4, domain: domainVal, service_type: serviceTypeVal })
        });
        data = await res.json();
        if (!res.ok) throw new Error(data.error || "R2 Bucket oluşturulamadı.");
        addLogLine(`CF R2: ${data.message}`, 'success');
        markStepSuccess(3);

        // Adım 5: Bind D1 & R2
        provSteps[4].className = 'prov-step';
        provSteps[4].querySelector('.prov-status').innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';
        addLogLine(">> Pages projesine D1 ve R2 bağlanıyor...", 'command');
        res = await fetch('/api/admin/provision', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ step: 5, domain: domainVal, service_type: serviceTypeVal, d1_uuid: d1Uuid })
        });
        data = await res.json();
        if (!res.ok) throw new Error(data.error || "Bindings yapılandırılamadı.");
        addLogLine(`CF Bindings: ${data.message}`, 'success');
        markStepSuccess(4);

        // Adım 6: Deploy
        provSteps[5].className = 'prov-step';
        provSteps[5].querySelector('.prov-status').innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';
        addLogLine(">> Bulut CDN dağıtımı tetikleniyor...", 'command');
        res = await fetch('/api/admin/provision', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ step: 6, domain: domainVal, service_type: serviceTypeVal })
        });
        data = await res.json();
        if (!res.ok) throw new Error(data.error || "Deploy işlemi başlatılamadı.");
        addLogLine(`Deploy: ${data.message}`, 'success');
        markStepSuccess(5);

        // Adım 7: SSL & Verify
        provSteps[6].className = 'prov-step';
        provSteps[6].querySelector('.prov-status').innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';
        addLogLine(">> Hizmet durumu ve SSL/HTTPS doğrulanıyor...", 'command');
        res = await fetch('/api/admin/provision', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ step: 7, domain: domainVal, service_type: serviceTypeVal })
        });
        data = await res.json();
        if (!res.ok) throw new Error(data.error || "Hizmet doğrulaması başarısız.");
        addLogLine(`Doğrulama: ${data.message}`, 'success');
        markStepSuccess(6);

        addLogLine("🎉 TEBRİKLER! Bulut kurulumu ve yapılandırması başarıyla tamamlandı. Artık hizmeti veritabanında aktifleştirebilirsiniz.", 'info');
        btnFinish.style.display = 'flex';

      } catch (err) {
        addLogLine(`❌ KURULUM HATASI: ${err.message}`, 'error');
        addLogLine("Lütfen girdiğiniz API anahtarlarını kontrol edin veya daha sonra tekrar deneyin.", 'info');
        btnBack3.style.display = 'flex';
      }
    }

    function markStepSuccess(index) {
      provSteps[index].className = 'prov-step success';
      provSteps[index].querySelector('.prov-status').innerHTML = '<i class="fa-solid fa-check-circle"></i>';
    }
  </script>

