---
// src/pages/business/index.astro
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getPartnerContactLink } from '../../utils/whatsapp';

export const prerender = false; // Sunucu tarafında anlık çalışmalıdır (SSR)

const user = Astro.locals.user;
if (!user || user.is_partner !== 1) {
  return Astro.redirect('/login?error=unauthorized');
}

const runtime = Astro.locals.runtime as any;
const db = runtime?.env?.DB;

if (!db) {
  return new Response("Cloudflare D1 Database binding is missing!", { status: 500 });
}

let successMessage = '';
let errorMessage = '';

// 1. Yeni Teklif Gönderme (POST)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action') as string;

    if (action === 'submit_offer') {
      // Sadece onaylı partnerler teklif gönderebilir
      if (user.is_approved !== 1) {
        errorMessage = 'Teklif gönderebilmek için hesabınızın onaylanmış olması gerekmektedir.';
      } else {
        const requestId = formData.get('request_id') as string;
        const priceStr = formData.get('price') as string;
        const duration = formData.get('duration') as string;

        const price = parseFloat(priceStr);

        if (!requestId || isNaN(price) || !duration) {
          errorMessage = 'Lütfen teklif fiyatı ve tamamlanma süresini doğru girin.';
        } else {
          // D1 Batch işlemle teklifi ekle ve talebin statüsünü güncelle
          await db.batch([
            db.prepare(
              "INSERT INTO offers (request_id, partner_id, price, duration, status) VALUES (?, ?, ?, ?, 'PENDING')"
            ).bind(requestId, user.id, price, duration),
            db.prepare(
              "UPDATE service_requests SET status = 'OFFER_RECEIVED' WHERE id = ? AND status = 'PENDING'"
            ).bind(requestId)
          ]);

          successMessage = 'Teklifiniz başarıyla müşteriye iletildi! Müşteri onayladığında size haber verilecektir.';
        }
      }
    }
  } catch (e) {
    console.error("Partner offer submission error:", e);
    errorMessage = 'Teklif gönderilirken veritabanı hatası oluştu.';
  }
}

// 2. D1 Veritabanı Sorguları
let myServices: any[] = [];
let activeJobs: any[] = [];
let pastJobs: any[] = [];
let pendingOffers: any[] = [];
let availablePool: any[] = [];
let hasNewLeads = false;

try {
  // A. İş ortağının uzmanlık dalları
  const servicesQuery = await db.prepare("SELECT service_category FROM partner_services WHERE partner_id = ?").bind(user.id).all();
  myServices = servicesQuery.results || [];

  if (myServices.length === 0) {
    return Astro.redirect('/onboarding');
  }

  // B. Aktif İşlerim (Kabul edilmiş teklifler)
  const activeQuery = await db.prepare(
    "SELECT o.id as offer_id, o.price, o.duration, r.id as request_id, r.title, r.description, r.category, r.image_url, u.id as client_id, u.name as client_name, u.phone as client_phone " +
    "FROM offers o " +
    "JOIN service_requests r ON o.request_id = r.id " +
    "JOIN users u ON r.client_id = u.id " +
    "WHERE o.partner_id = ? AND o.status = 'ACCEPTED' AND r.status != 'COMPLETED'"
  ).bind(user.id).all();
  activeJobs = activeQuery.results || [];

  // C. Eski İşlerim (Reddedilmiş teklifler veya tamamlanmış kabul edilen işler)
  const pastQuery = await db.prepare(
    "SELECT o.id as offer_id, o.price, o.status as offer_status, r.id as request_id, r.title, r.category, r.status as req_status " +
    "FROM offers o " +
    "JOIN service_requests r ON o.request_id = r.id " +
    "WHERE o.partner_id = ? AND (o.status = 'REJECTED' OR r.status = 'COMPLETED')"
  ).bind(user.id).all();
  pastJobs = pastQuery.results || [];

  // D. Beklemedeki Tekliflerim (Henüz onaylanmamış veya reddedilmemiş)
  const pendingQuery = await db.prepare(
    "SELECT o.id as offer_id, o.price, o.duration, o.status as offer_status, r.id as request_id, r.title, r.category " +
    "FROM offers o " +
    "JOIN service_requests r ON o.request_id = r.id " +
    "WHERE o.partner_id = ? AND o.status = 'PENDING' AND r.status != 'ACCEPTED'"
  ).bind(user.id).all();
  pendingOffers = pendingQuery.results || [];

  // E. Teklif Ver (Hizmet Havuzu) - Sadece Onaylıysa çek
  if (user.is_approved === 1) {
    const rawPool = await db.prepare(
      "SELECT r.*, u.name as client_name FROM service_requests r " +
      "JOIN users u ON r.client_id = u.id " +
      "WHERE r.status IN ('PENDING', 'OFFER_RECEIVED') " +
      "AND r.id NOT IN (SELECT request_id FROM offers WHERE partner_id = ?) " +
      "ORDER BY r.created_at DESC"
    ).bind(user.id).all();

    const poolResults = rawPool.results || [];

    // Sadece iş ortağının seçtiği uzmanlık dallarına uyan talepleri filtrele
    const selectedCatNames = myServices.map(s => s.service_category);
    availablePool = poolResults.filter((req: any) => selectedCatNames.includes(req.category));

    if (availablePool.length > 0) {
      hasNewLeads = true;
    }
  }

} catch (err) {
  console.error("Partner index data query error:", err);
}
---

<DashboardLayout title="İş Ortağı Paneli | İş De Yeter" activeTab="overview">
  <div class="flex flex-col gap-8 max-w-7xl mx-auto px-2">
    
    <!-- Prominent "Start Free Service" Button At The Very Top -->
    <div class="flex justify-start">
      <a href="/business/sites" class="bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white px-8 py-4 rounded-2xl font-bold text-lg flex items-center gap-3 transition-all duration-300 shadow-lg shadow-emerald-500/25 hover:-translate-y-1">
        <i class="fa-solid fa-wand-magic-sparkles text-xl"></i>
        <span>İş de Yeter Ücretsiz Hizmetlerini İncele</span>
      </a>
    </div>

    <div class="flex flex-col">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">İş Ortağı Çalışma Paneli</h1>
      <p class="text-slate-500 mt-2 text-sm sm:text-base">Teklif verdiğiniz işleri takip edebilir, tamamlanan işlerinizi görebilir veya uzmanlık alanınıza düşen yeni taleplere hızlıca fiyat verebilirsiniz.</p>
    </div>

    {successMessage && (
      <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 p-4 rounded-xl flex items-center gap-3 shadow-sm font-medium">
        <i class="fa-solid fa-circle-check text-xl"></i>
        <span>{successMessage}</span>
      </div>
    )}

    {errorMessage && (
      <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl flex items-center gap-3 shadow-sm font-medium">
        <i class="fa-solid fa-triangle-exclamation text-xl"></i>
        <span>{errorMessage}</span>
      </div>
    )}

    <!-- Category Badges Bar -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col sm:flex-row sm:items-center gap-4">
      <span class="text-sm font-bold text-slate-700 uppercase tracking-wide">Uzmanlık Alanlarım (Maks 3):</span>
      <div class="flex items-center gap-2 flex-wrap">
        {myServices.map((s: any) => (
          <span class="bg-blue-50 text-blue-600 text-xs font-bold px-4 py-1.5 rounded-full border border-blue-100">{s.service_category}</span>
        ))}
        <a href="/onboarding" class="text-slate-500 text-xs font-semibold hover:text-blue-600 ml-2 transition-colors flex items-center gap-1">
          <i class="fa-solid fa-pen-to-square"></i> Düzenle
        </a>
      </div>
    </div>

    <!-- Onay Bekliyor Uyarısı -->
    {user.is_approved !== 1 && (
      <div class="bg-amber-50 border border-amber-300 rounded-2xl p-6 shadow-sm flex flex-col sm:flex-row gap-5 items-start text-amber-800">
        <div class="bg-amber-100 p-3 rounded-full shrink-0">
          <i class="fa-solid fa-circle-exclamation text-2xl text-amber-600"></i>
        </div>
        <div class="flex flex-col gap-2">
          <h3 class="text-lg font-bold text-amber-900">Hesabınız Onay Bekliyor</h3>
          <p class="text-sm leading-relaxed opacity-90">
            İş ortağı profiliniz sistem yöneticisi tarafından inceleniyor. <br/>
            Yönetici onayından sonra uzmanlık alanınızdaki müşteri taleplerine teklif vermeye başlayabilirsiniz. <br/>
            Bu süreçte sizin ek bir işlem yapmanıza gerek yoktur. Sizlerle iletişime geçilecektir.
          </p>
        </div>
      </div>
    )}

    <!-- Tabbed Jobs Center -->
    <div class="bg-white border border-slate-200 rounded-3xl p-4 sm:p-8 shadow-sm flex flex-col gap-6 sm:gap-8">
      
      <!-- Tabs Navigation -->
      <div class="flex bg-slate-100/80 p-1.5 rounded-2xl border border-slate-200 overflow-x-auto gap-1 hide-scrollbar">
        <button type="button" class="tab-btn bg-white text-blue-600 shadow-sm border border-slate-200/60 rounded-xl px-4 sm:px-5 py-2.5 sm:py-3 text-[13px] sm:text-sm font-bold whitespace-nowrap transition-all flex items-center gap-2" data-target="tab-active">
          <i class="fa-solid fa-briefcase"></i> Aktif İşlerim ({activeJobs.length})
        </button>
        <button type="button" class="tab-btn text-slate-500 hover:text-slate-700 hover:bg-slate-200/50 rounded-xl px-4 sm:px-5 py-2.5 sm:py-3 text-[13px] sm:text-sm font-semibold whitespace-nowrap transition-all flex items-center gap-2" data-target="tab-past">
          <i class="fa-solid fa-clock-rotate-left"></i> Eski İşlerim ({pastJobs.length})
        </button>
        <button type="button" class="tab-btn text-slate-500 hover:text-slate-700 hover:bg-slate-200/50 rounded-xl px-4 sm:px-5 py-2.5 sm:py-3 text-[13px] sm:text-sm font-semibold whitespace-nowrap transition-all flex items-center gap-2" data-target="tab-pool">
          <i class="fa-solid fa-gavel"></i> Teklif Ver / İş Havuzu ({user.is_approved === 1 ? availablePool.length : 0})
          {hasNewLeads && user.is_approved === 1 && (
            <span class="animate-pulse ml-1 text-amber-500" title="Uzmanlık alanınızda yeni iş fırsatı var!">⚠️</span>
          )}
        </button>
        <button type="button" class="tab-btn text-slate-500 hover:text-slate-700 hover:bg-slate-200/50 rounded-xl px-4 sm:px-5 py-2.5 sm:py-3 text-[13px] sm:text-sm font-semibold whitespace-nowrap transition-all flex items-center gap-2" data-target="tab-pending">
          <i class="fa-solid fa-hourglass-half"></i> Bekleyen Tekliflerim ({pendingOffers.length})
        </button>
      </div>

      <!-- Tab Content Area -->
      <div class="relative min-h-[400px]">
        
        <!-- A. AKTİF İŞLERİM (ACCEPTED) -->
        <div id="tab-active" class="tab-pane block animate-fade-in">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {activeJobs.map((job: any) => (
              <div class="flex flex-col bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
                <div class="bg-white border-b border-slate-200 p-4 flex justify-between items-center">
                  <span class="bg-blue-50 text-blue-600 text-[10px] uppercase font-bold px-2.5 py-1 rounded-md">{job.category}</span>
                  <span class="bg-emerald-50 text-emerald-600 text-[10px] uppercase font-bold px-2.5 py-1 rounded-md flex items-center gap-1"><i class="fa-solid fa-circle-check"></i> Kabul Edildi</span>
                </div>
                
                <div class="p-5 flex flex-col gap-4 flex-1">
                  <div>
                    <h3 class="text-lg font-bold text-slate-900 mb-1 leading-snug">{job.title}</h3>
                    <p class="text-sm text-slate-500 line-clamp-3">{job.description}</p>
                  </div>
                  
                  {job.image_url && (
                    <a href={job.image_url} target="_blank" class="inline-flex items-center gap-2 text-xs font-semibold text-blue-600 bg-blue-50 border border-blue-100 px-3 py-1.5 rounded-lg w-max hover:bg-blue-100 transition-colors">
                      <i class="fa-solid fa-image"></i> Yüklenen Görseli Gör
                    </a>
                  )}

                  <div class="bg-white border border-slate-200 rounded-xl p-4 mt-auto shadow-sm">
                    <h4 class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Müşteri Bilgileri</h4>
                    <p class="font-semibold text-sm text-slate-700 flex items-center gap-2 mb-3">
                      <i class="fa-solid fa-user text-blue-500"></i> {job.client_name}
                    </p>
                    
                    <a href={getPartnerContactLink(job.client_name, job.client_id, job.request_id)} target="_blank" class="bg-emerald-500 hover:bg-emerald-600 text-white text-[13px] font-bold px-4 py-2.5 rounded-lg flex items-center justify-center gap-2 transition-colors shadow-sm">
                      <i class="fa-brands fa-whatsapp text-base"></i> Müşteriyle WhatsApp'tan Görüş
                    </a>
                  </div>
                </div>

                <div class="bg-white border-t border-slate-200 p-4 flex justify-between items-center text-sm">
                  <span class="font-extrabold text-emerald-600">Kazanılan: {job.price} TL</span>
                  <span class="font-semibold text-slate-500 flex items-center gap-1.5"><i class="fa-regular fa-clock text-slate-400"></i> {job.duration}</span>
                </div>
              </div>
            ))}

            {activeJobs.length === 0 && (
              <div class="col-span-full py-16 flex flex-col items-center justify-center text-center gap-4 bg-slate-50 rounded-2xl border border-dashed border-slate-300">
                <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center text-slate-300 text-3xl">
                  <i class="fa-solid fa-file-signature"></i>
                </div>
                <p class="text-slate-500 max-w-sm">Şu an aktif olarak üstlendiğiniz bir iş bulunmamaktadır. İş havuzunu inceleyerek yeni işlere teklif verin!</p>
              </div>
            )}
          </div>
        </div>

        <!-- B. ESKİ İŞLERİM (REJECTED veya COMPLETED) -->
        <div id="tab-past" class="tab-pane hidden animate-fade-in">
          <div class="overflow-x-auto bg-white border border-slate-200 rounded-2xl">
            <table class="w-full text-left text-sm whitespace-nowrap">
              <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                  <th class="px-6 py-4 font-bold text-slate-500 uppercase tracking-wider text-[11px]">Talep Başlığı</th>
                  <th class="px-6 py-4 font-bold text-slate-500 uppercase tracking-wider text-[11px]">Hizmet Kategorisi</th>
                  <th class="px-6 py-4 font-bold text-slate-500 uppercase tracking-wider text-[11px]">Teklif Fiyatım</th>
                  <th class="px-6 py-4 font-bold text-slate-500 uppercase tracking-wider text-[11px]">Teklif Durumu</th>
                  <th class="px-6 py-4 font-bold text-slate-500 uppercase tracking-wider text-[11px]">Talep Durumu</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {pastJobs.map((job: any) => (
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-4 font-semibold text-slate-800">{job.title}</td>
                    <td class="px-6 py-4 text-slate-600">{job.category}</td>
                    <td class="px-6 py-4 font-bold text-slate-700">{job.price} TL</td>
                    <td class="px-6 py-4">
                      {job.offer_status === 'ACCEPTED' ? (
                        <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-600 text-[11px] font-bold px-2.5 py-1 rounded-md uppercase"><i class="fa-solid fa-check"></i> Kabul Edildi</span>
                      ) : (
                        <span class="inline-flex items-center gap-1.5 bg-red-50 text-red-600 text-[11px] font-bold px-2.5 py-1 rounded-md uppercase"><i class="fa-solid fa-xmark"></i> Reddedildi</span>
                      )}
                    </td>
                    <td class="px-6 py-4">
                      <span class={`inline-flex items-center text-[10px] uppercase font-bold px-2 py-1 rounded-md ${
                        job.req_status === 'COMPLETED' ? 'bg-slate-100 text-slate-600' : 
                        job.req_status === 'ACCEPTED' ? 'bg-emerald-50 text-emerald-600' : 'bg-amber-50 text-amber-600'
                      }`}>
                        {job.req_status}
                      </span>
                    </td>
                  </tr>
                ))}
                {pastJobs.length === 0 && (
                  <tr>
                    <td colspan="5" class="px-6 py-12 text-center text-slate-400">Tamamlanan veya reddedilen eski bir iş kaydınız bulunmuyor.</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>

        <!-- C. TEKLİF VER / İŞ HAVUZU (MATCHING PENDING REQUESTS) -->
        <div id="tab-pool" class="tab-pane hidden animate-fade-in">
          {user.is_approved === 1 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
              {availablePool.map((req: any) => (
                <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm flex flex-col hover:border-blue-300 transition-colors">
                  
                  <div class="bg-slate-50 border-b border-slate-200 p-4 flex justify-between items-center">
                    <span class="bg-blue-50 text-blue-600 text-[10px] uppercase font-bold px-2.5 py-1 rounded-md">{req.category}</span>
                    <span class="text-xs font-semibold text-slate-500 flex items-center gap-1.5"><i class="fa-solid fa-user-tie text-slate-400"></i> {req.client_name}</span>
                  </div>

                  <div class="p-6 flex flex-col gap-4 flex-1">
                    <div>
                      <h3 class="text-xl font-extrabold text-slate-900 mb-2 leading-tight">{req.title}</h3>
                      <p class="text-[13px] text-slate-600 leading-relaxed">{req.description}</p>
                    </div>
                    
                    {req.image_url && (
                      <a href={req.image_url} target="_blank" class="inline-flex items-center gap-2 text-[11px] font-bold text-blue-600 bg-blue-50 border border-blue-100 px-3 py-1.5 rounded-lg w-max hover:bg-blue-100 transition-colors mt-2">
                        <i class="fa-solid fa-image"></i> Resim Önizleme
                      </a>
                    )}
                  </div>

                  <div class="p-5 bg-slate-50 border-t border-slate-200 mt-auto">
                    <form method="POST" class="flex flex-col gap-4">
                      <input type="hidden" name="action" value="submit_offer" />
                      <input type="hidden" name="request_id" value={req.id} />
                      
                      <div class="grid grid-cols-2 gap-4">
                        <div class="flex flex-col gap-1.5">
                          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Fiyat Teklifi (TL)</label>
                          <input type="number" name="price" required min="1" placeholder="Tutar girin" class="bg-white border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-semibold text-slate-800" />
                        </div>
                        
                        <div class="flex flex-col gap-1.5">
                          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Süre Teklifi</label>
                          <select name="duration" required class="bg-white border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-semibold text-slate-800 bg-none">
                            <option value="1 Gün">1 Gün</option>
                            <option value="2 Gün">2 Gün</option>
                            <option value="3 Gün">3 Gün</option>
                            <option value="5 Gün">5 Gün</option>
                            <option value="1 Hafta">1 Hafta</option>
                            <option value="2 Hafta">2 Hafta</option>
                          </select>
                        </div>
                      </div>

                      <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl transition-all shadow-md shadow-blue-600/20 flex items-center justify-center gap-2 mt-1">
                        <i class="fa-solid fa-paper-plane"></i> Teklifi Gönder
                      </button>
                    </form>
                  </div>

                </div>
              ))}

              {availablePool.length === 0 && (
                <div class="col-span-full py-20 flex flex-col items-center justify-center text-center gap-4 bg-slate-50 rounded-3xl border border-dashed border-slate-300">
                  <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center text-slate-300 text-4xl shadow-sm border border-slate-100">
                    <i class="fa-solid fa-gavel"></i>
                  </div>
                  <h3 class="text-lg font-bold text-slate-700 mt-2">İş Havuzu Boş</h3>
                  <p class="text-slate-500 max-w-md text-sm">Şu an uzmanlık kategorilerinizde teklif verebileceğiniz yeni bir talep bulunmamaktadır. Yeni ilanlar açıldığında burada listelenecektir.</p>
                </div>
              )}
            </div>
          ) : (
            <div class="py-20 flex flex-col items-center justify-center text-center gap-5 bg-slate-50 rounded-3xl border border-dashed border-slate-300 px-6">
              <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center text-amber-300 text-4xl shadow-sm border border-slate-100">
                <i class="fa-solid fa-lock"></i>
              </div>
              <h3 class="text-xl font-bold text-slate-800">Hizmet Havuzu Kilitli</h3>
              <p class="text-slate-500 max-w-lg leading-relaxed text-sm">Müşterilerin güncel hizmet ilanlarını görebilmek ve teklif vererek iş alabilmek için hesabınızın admin tarafından onaylanması gerekmektedir. Profil bilgilerinizi eksiksiz doldurarak bekleyin.</p>
            </div>
          )}
        </div>

        <!-- D. BEKLEYEN TEKLİFLERİM (PENDING BIDS) -->
        <div id="tab-pending" class="tab-pane hidden animate-fade-in">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {pendingOffers.map((offer: any) => (
              <div class="flex flex-col bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
                <div class="bg-white border-b border-slate-200 p-4 flex justify-between items-center">
                  <span class="bg-blue-50 text-blue-600 text-[10px] uppercase font-bold px-2.5 py-1 rounded-md">{offer.category}</span>
                  <span class="bg-amber-50 text-amber-600 text-[10px] uppercase font-bold px-2.5 py-1 rounded-md flex items-center gap-1.5"><i class="fa-solid fa-hourglass-half"></i> Beklemede</span>
                </div>
                
                <div class="p-6 flex flex-col gap-3 flex-1">
                  <h3 class="text-lg font-bold text-slate-900 leading-snug">{offer.title}</h3>
                  <p class="text-[13px] text-slate-500 italic">Fiyat ve süre teklifiniz müşteriye iletildi. Müşteri teklifleri değerlendiriyor.</p>
                </div>

                <div class="bg-white border-t border-slate-200 p-4 flex justify-between items-center text-sm">
                  <span class="font-extrabold text-blue-600">Teklif: {offer.price} TL</span>
                  <span class="font-semibold text-slate-500 flex items-center gap-1.5"><i class="fa-regular fa-clock"></i> {offer.duration}</span>
                </div>
              </div>
            ))}

            {pendingOffers.length === 0 && (
              <div class="col-span-full py-16 flex flex-col items-center justify-center text-center gap-4 bg-slate-50 rounded-2xl border border-dashed border-slate-300">
                <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center text-slate-300 text-3xl">
                  <i class="fa-solid fa-hourglass"></i>
                </div>
                <p class="text-slate-500 max-w-sm">Beklemede olan herhangi bir fiyat teklifiniz bulunmamaktadır.</p>
              </div>
            )}
          </div>
        </div>

      </div>

    </div>

  </div>

  <style>
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(5px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeIn 0.3s ease-out forwards;
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabPanes = document.querySelectorAll('.tab-pane');

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          tabBtns.forEach(b => {
            b.classList.remove('bg-white', 'text-blue-600', 'shadow-sm', 'border-slate-200/60');
            b.classList.add('text-slate-500', 'hover:text-slate-700', 'hover:bg-slate-200/50', 'border-transparent');
          });

          btn.classList.remove('text-slate-500', 'hover:text-slate-700', 'hover:bg-slate-200/50', 'border-transparent');
          btn.classList.add('bg-white', 'text-blue-600', 'shadow-sm', 'border-slate-200/60');

          tabPanes.forEach(pane => {
            pane.classList.remove('block');
            pane.classList.add('hidden');
          });

          const targetId = btn.getAttribute('data-target');
          const targetPane = document.getElementById(targetId);
          if (targetPane) {
            targetPane.classList.remove('hidden');
            targetPane.classList.add('block');
          }
        });
      });
    });
  </script>
</DashboardLayout>
