---
// src/pages/business/invoices.astro
import DashboardLayout from '../../layouts/DashboardLayout.astro';

export const prerender = false;

const user = Astro.locals.user;
if (!user || user.is_partner !== 1) {
  return Astro.redirect('/login?error=unauthorized');
}

const mockInvoices = [
  { id: 'HK-2026-104', type: 'Hakediş Faturası', amount: '1.250 TL', date: '2026-06-10', status: 'Ödeme Bekliyor' }
];
---

<DashboardLayout title="Faturalar & Hakedişler | İş De Yeter İş Ortağı" activeTab="invoices">
  <div class="max-w-6xl mx-auto space-y-6">
    <h1 class="text-2xl font-bold text-gray-900">Faturalar & Hakedişler</h1>
    <p class="text-gray-500">Tamamladığınız işler için düzenlenen hakediş belgeleri ve komisyon faturaları.</p>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      {mockInvoices.length > 0 ? (
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200 text-sm text-gray-600">
              <th class="py-4 px-6 font-semibold">Belge No</th>
              <th class="py-4 px-6 font-semibold">Tür</th>
              <th class="py-4 px-6 font-semibold">Tarih</th>
              <th class="py-4 px-6 font-semibold">Tutar</th>
              <th class="py-4 px-6 font-semibold">Durum</th>
              <th class="py-4 px-6 font-semibold">İşlem</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 text-sm">
            {mockInvoices.map(inv => (
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="py-4 px-6 font-medium text-gray-900">{inv.id}</td>
                <td class="py-4 px-6 text-gray-800">{inv.type}</td>
                <td class="py-4 px-6 text-gray-600">{inv.date}</td>
                <td class="py-4 px-6 font-semibold text-gray-900">{inv.amount}</td>
                <td class="py-4 px-6">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                    {inv.status}
                  </span>
                </td>
                <td class="py-4 px-6 flex gap-3">
                  <button class="text-blue-600 hover:text-blue-800 font-medium text-xs flex items-center gap-1"><i class="fa-solid fa-eye"></i> İncele</button>
                  <button class="text-gray-600 hover:text-gray-900 font-medium text-xs flex items-center gap-1"><i class="fa-solid fa-download"></i> PDF</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <div class="p-12 text-center text-gray-500">
          <i class="fa-solid fa-file-invoice text-4xl mb-4 text-gray-300"></i>
          <p>Kayıtlı faturanız veya hakediş belgeniz bulunmamaktadır.</p>
        </div>
      )}
    </div>
  </div>
</DashboardLayout>
