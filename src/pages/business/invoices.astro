---
// src/pages/business/invoices.astro
import DashboardLayout from '../../layouts/DashboardLayout.astro';

export const prerender = false;

const user = Astro.locals.user;
if (!user || user.is_partner !== 1) {
  return Astro.redirect('/login?error=unauthorized');
}

const mockInvoices = [
  { id: 'HK-2026-104', type: 'Hakediş Faturası', amount: '1.250 TL', date: '2026-06-10', status: 'Ödeme Bekliyor' }
];
---

<DashboardLayout title="Faturalar & Hakedişler | İş De Yeter İş Ortağı" activeTab="invoices">
  <div class="flex flex-col gap-8 max-w-7xl mx-auto px-2">
    <div class="flex flex-col">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Faturalar & Hakedişler</h1>
      <p class="text-slate-500 mt-2 text-sm sm:text-base">Tamamladığınız işler için düzenlenen hakediş belgeleri ve komisyon faturalarını buradan inceleyebilirsiniz.</p>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden flex flex-col">
      <div class="p-6 border-b border-slate-100 flex items-center gap-3">
        <div class="w-10 h-10 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center">
          <i class="fa-solid fa-file-invoice-dollar"></i>
        </div>
        <h2 class="text-xl font-bold text-slate-800">Fatura Kayıtları</h2>
      </div>

      {mockInvoices.length > 0 ? (
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse whitespace-nowrap">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
                <th class="py-4 px-6">Belge No</th>
                <th class="py-4 px-6">Tür</th>
                <th class="py-4 px-6">Tarih</th>
                <th class="py-4 px-6">Tutar</th>
                <th class="py-4 px-6">Durum</th>
                <th class="py-4 px-6 text-right">İşlem</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-sm">
              {mockInvoices.map(inv => (
                <tr class="hover:bg-slate-50 transition-colors group">
                  <td class="py-4 px-6">
                    <span class="font-bold text-slate-800 bg-slate-100 px-2.5 py-1 rounded-md text-[13px]">{inv.id}</span>
                  </td>
                  <td class="py-4 px-6 font-semibold text-slate-700">
                    <span class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 px-2.5 py-1 rounded-md text-[11px] uppercase tracking-wide">
                      <i class="fa-solid fa-file-invoice"></i> {inv.type}
                    </span>
                  </td>
                  <td class="py-4 px-6 text-slate-500 font-medium">
                    <i class="fa-regular fa-calendar mr-1.5 text-slate-400"></i>{inv.date}
                  </td>
                  <td class="py-4 px-6 font-extrabold text-slate-800">
                    {inv.amount}
                  </td>
                  <td class="py-4 px-6">
                    <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-[11px] font-bold uppercase tracking-wide ${inv.status === 'Ödendi' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'}`}>
                      <i class={`fa-solid ${inv.status === 'Ödendi' ? 'fa-check-double' : 'fa-clock'}`}></i>
                      {inv.status}
                    </span>
                  </td>
                  <td class="py-4 px-6 flex items-center justify-end gap-2">
                    <button class="bg-white border border-slate-200 hover:border-blue-300 text-blue-600 hover:text-blue-700 hover:bg-blue-50 font-bold text-xs px-3 py-2 rounded-lg transition-all shadow-sm flex items-center gap-1.5">
                      <i class="fa-solid fa-eye"></i> İncele
                    </button>
                    <button class="bg-white border border-slate-200 hover:border-slate-300 text-slate-600 hover:text-slate-800 hover:bg-slate-50 font-bold text-xs px-3 py-2 rounded-lg transition-all shadow-sm flex items-center gap-1.5">
                      <i class="fa-solid fa-download"></i> PDF
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="py-20 flex flex-col items-center justify-center text-center gap-4 bg-slate-50/50">
          <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center text-slate-300 text-4xl shadow-sm border border-slate-100">
            <i class="fa-solid fa-file-invoice"></i>
          </div>
          <p class="text-slate-500 font-medium max-w-sm mt-2">Kayıtlı faturanız veya hakediş belgeniz bulunmamaktadır.</p>
        </div>
      )}
    </div>
  </div>
</DashboardLayout>
