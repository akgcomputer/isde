---
// src/pages/business/orders.astro
import DashboardLayout from '../../layouts/DashboardLayout.astro';

export const prerender = false;

const user = Astro.locals.user;
if (!user || user.is_partner !== 1) {
  return Astro.redirect('/login?error=unauthorized');
}

const mockOrders = [
  { id: 'SİP-10042', client: 'Ahmet Yılmaz', date: '2026-06-10', total: '1.250 TL', status: 'Hazırlanıyor' }
];
---

<DashboardLayout title="İş Siparişleri | İş De Yeter İş Ortağı" activeTab="orders">
  <div class="max-w-6xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">İş Siparişleri</h1>
        <p class="text-gray-500 mt-1">Üstlendiğiniz projeler ve aktif siparişleriniz.</p>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      {mockOrders.length > 0 ? (
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50 border-b border-gray-200 text-sm text-gray-600">
                <th class="py-4 px-6 font-semibold">Sipariş Kodu</th>
                <th class="py-4 px-6 font-semibold">Müşteri</th>
                <th class="py-4 px-6 font-semibold">Tarih</th>
                <th class="py-4 px-6 font-semibold">Hakediş</th>
                <th class="py-4 px-6 font-semibold">Durum</th>
                <th class="py-4 px-6 font-semibold">İşlem</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 text-sm">
              {mockOrders.map(order => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="py-4 px-6 font-medium text-gray-900">{order.id}</td>
                  <td class="py-4 px-6 text-gray-800">{order.client}</td>
                  <td class="py-4 px-6 text-gray-600">{order.date}</td>
                  <td class="py-4 px-6 font-semibold text-green-600">{order.total}</td>
                  <td class="py-4 px-6">
                    <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${order.status === 'Tamamlandı' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800'}`}>
                      {order.status}
                    </span>
                  </td>
                  <td class="py-4 px-6">
                    <button class="text-blue-600 hover:text-blue-800 font-medium text-xs">Yönet</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="p-12 text-center text-gray-500">
          <i class="fa-solid fa-clipboard-check text-4xl mb-4 text-gray-300"></i>
          <p>Şu anda aktif bir siparişiniz bulunmamaktadır.</p>
        </div>
      )}
    </div>
  </div>
</DashboardLayout>
