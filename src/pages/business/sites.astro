---
// src/pages/business/sites.astro
import DashboardLayout from '../../layouts/DashboardLayout.astro';

export const prerender = false; // Sunucu tarafında anlık çalışmalıdır (SSR)

const user = Astro.locals.user;
if (!user || user.is_partner !== 1) {
  return Astro.redirect('/login?error=unauthorized');
}

const runtime = Astro.locals.runtime as any;
const db = runtime?.env?.DB;

let successMessage = '';
let errorMessage = '';

// Form Gönderim (POST) - Yeni Hizmet / Site Talebi
if (Astro.request.method === 'POST' && db) {
  try {
    const formData = await Astro.request.formData();
    const noDomain = formData.get('no_domain') === '1';
    let domainInput = '';
    const mode = formData.get('mode') as string;

    if (noDomain) {
      const desired = (formData.get('desired_domain') as string || '').trim().toLowerCase();
      if (!desired) {
        errorMessage = 'Lütfen istediğiniz alan adını girin.';
      } else {
        const subdomainRegex = /^[a-z0-9-]+$/;
        if (!subdomainRegex.test(desired)) {
          errorMessage = 'İstediğiniz alan adı sadece küçük harf, rakam ve tire (-) içerebilir.';
        } else {
          domainInput = `${desired} (Alan Adı Alınacak)`;
        }
      }
    } else {
      domainInput = (formData.get('domain') as string || '').trim().toLowerCase();
      if (!domainInput) {
        errorMessage = 'Lütfen sahip olduğunuz alan adını girin.';
      } else {
        const domainRegex = /^[a-z0-9]+([\-\.]{1}[a-z0-9]+)*\.[a-z]{2,5}$/;
        if (!domainRegex.test(domainInput)) {
          errorMessage = 'Geçersiz özel alan adı formatı (Örn: isletme-marka-adiniz.com).';
        }
      }
    }

    if (!errorMessage) {
      let finalDomain = domainInput;

      if (!errorMessage) {
        // Veritabanında çakışma var mı kontrol et
        const existing = await db.prepare("SELECT * FROM sites WHERE domain = ?").bind(finalDomain).first();

        if (existing) {
          errorMessage = `"${finalDomain}" adresi zaten kullanımda. Lütfen başka bir adres seçin.`;
        } else {
          // 1. Veritabanına PENDING durumunda ekle (service_type: 'web_sitesi')
          await db.prepare(
            "INSERT INTO sites (user_id, domain, mode, status, service_type) VALUES (?, ?, ?, 'PENDING', 'web_sitesi')"
          ).bind(user.id, finalDomain, mode).run();

          // 2. Webhook Tetikleme
          const n8nUrl = runtime.env.N8N_WEBHOOK_URL || 'https://n8n.isdeyeter.com/webhook/mock-site-builder';
          const payload = {
            user_id: user.id,
            user_email: user.email,
            user_name: user.name,
            domain: finalDomain,
            mode: mode,
            timestamp: new Date().toISOString()
          };

          try {
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 4000);

            fetch(n8nUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
              signal: controller.signal
            }).then(res => {
              clearTimeout(timeoutId);
              console.log(`n8n webhook tetiklendi. Durum: ${res.status}`);
            }).catch(err => {
              clearTimeout(timeoutId);
              console.error("Webhook HTTP Hatası:", err.message);
            });
          } catch (webhookErr) {
            console.error("Webhook Trigger Fail:", webhookErr);
          }

          successMessage = `"${finalDomain}" adresli web sitenizin kurulum talebi başarıyla alındı! Sistem arka planda otomatik kurulumu başlattı.`;
        }
      }
    }
  } catch (e) {
    console.error("Site creation error:", e);
    errorMessage = 'Hizmet oluşturulurken beklenmedik bir sistem hatası oluştu.';
  }
}

// Kayıtlı siteleri listele
let mySites: any[] = [];
if (db) {
  try {
    const query = await db.prepare("SELECT * FROM sites WHERE user_id = ? ORDER BY created_at DESC").bind(user.id).all();
    mySites = query.results || [];
  } catch (e) {
    console.error("Fetch sites D1 error:", e);
  }
}
---

<DashboardLayout title="Ücretsiz Hizmetlerim | İş De Yeter" activeTab="sites">
  <div class="flex flex-col gap-8 max-w-7xl mx-auto px-2">
    
    <div class="flex flex-col">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Ücretsiz Hizmetlerim & Sitelerim</h1>
      <p class="text-slate-500 mt-2 text-sm sm:text-base">İş ortaklarımıza özel web altyapısını kullanarak kendi markanıza özel profesyonel hizmet sitenizi saniyeler içinde kurun.</p>
    </div>

    <!-- Alerts -->
    {successMessage && (
      <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 p-4 rounded-xl flex items-center gap-3 shadow-sm font-medium">
        <i class="fa-solid fa-circle-check text-xl"></i>
        <span>{successMessage}</span>
      </div>
    )}

    {errorMessage && (
      <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl flex items-center gap-3 shadow-sm font-medium">
        <i class="fa-solid fa-triangle-exclamation text-xl"></i>
        <span>{errorMessage}</span>
      </div>
    )}

    <!-- Split content: Form on left, active sites on right -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      
      <!-- Creation Form -->
      <form method="POST" class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm flex flex-col gap-6">
        <h2 class="text-xl font-bold text-slate-800 flex items-center gap-3 border-b border-slate-100 pb-4">
          <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
          </div>
          Yeni Web Sitesi Başlat
        </h2>
        
        <div class="flex flex-col gap-2" id="domain-primary-group">
          <label for="domain" class="text-sm font-bold text-slate-600">Kendi Özel Alan Adınız (Domain)</label>
          <div class="flex border border-slate-300 rounded-xl overflow-hidden bg-white focus-within:border-blue-500 focus-within:ring-4 focus-within:ring-blue-500/10 transition-all">
            <input 
              type="text" 
              name="domain" 
              id="domain" 
              placeholder="isletme-marka-adiniz.com" 
              class="w-full border-none px-4 py-3 text-slate-800 text-sm outline-none bg-transparent"
            />
          </div>
          <small class="text-[13px] text-slate-500 mt-1" id="domain-helper">Satın aldığınız alan adını girin (Örn: isdeyeter.com gibi). Eğer Domain (alan adı) almadıysanız size ekibimiz destek olacaktır.</small>
        </div>

        <div class="flex items-center gap-2 mt-1">
          <label class="flex items-center gap-2.5 cursor-pointer">
            <input type="checkbox" id="no-domain-check" name="no_domain" value="1" class="w-5 h-5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" />
            <span class="font-bold text-slate-800">Alan adı almadım</span>
          </label>
        </div>

        <div class="hidden flex-col gap-3 mt-2 bg-slate-50/80 p-5 rounded-2xl border-2 border-dashed border-slate-200" id="desired-domain-group">
          <label for="desired-domain" class="text-sm font-bold text-slate-700">İstediğiniz alan adını yazınız</label>
          <input 
            type="text" 
            name="desired_domain" 
            id="desired-domain" 
            placeholder="Örn: comlekgida" 
            class="w-full border border-slate-300 rounded-xl px-4 py-3 text-slate-800 text-sm outline-none bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all"
          />
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 mt-1">
            <small class="text-[12px] text-amber-800 leading-relaxed block">
              Örneğin Çömlek Gıda için <strong class="bg-amber-200/50 px-1.5 py-0.5 rounded text-amber-900">comlekgida</strong> yazmalısınız. İsim uzantısı (.com, .net, .com.tr müsait olanı tarafınıza bildirilecek).<br/>
              Sadece küçük harfler, rakamlar ve tire (-) kullanın. Türkçe karakter kullanmayın.
            </small>
          </div>
        </div>

        <div class="flex flex-col gap-2 mt-2">
          <label for="mode" class="text-sm font-bold text-slate-600">Web Sitesi Çalışma Modu (Model)</label>
          <div class="relative">
            <select name="mode" id="mode" class="w-full appearance-none border border-slate-300 rounded-xl px-4 py-3.5 text-slate-800 text-sm outline-none bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all font-medium" required>
              <optgroup label="Tekil Kullanım">
                <option value="blog">Sadece Blog Web Sitesi</option>
                <option value="kurumsal" selected>Sadece Kurumsal Tanıtım Web Sitesi</option>
                <option value="eticaret">Sadece E-Ticaret Web Sitesi</option>
              </optgroup>
              <optgroup label="Karma Web Sitesi Kullanımı">
                <option value="blog_kurumsal">Blog + Kurumsal</option>
                <option value="kurumsal_eticaret">Kurumsal + E-Ticaret</option>
                <option value="blog_eticaret">Blog + E-Ticaret</option>
                <option value="hepsi">Blog + E-Ticaret + Kurumsal (Hepsi)</option>
              </optgroup>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500">
              <i class="fa-solid fa-chevron-down text-xs"></i>
            </div>
          </div>
        </div>

        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-xl transition-all shadow-md shadow-blue-600/20 flex items-center justify-center gap-2 mt-4 text-[15px]">
          <i class="fa-solid fa-cloud-arrow-up text-lg"></i>
          <span>Kurulum Talebi Gönder</span>
        </button>
      </form>

      <!-- Active Sites List -->
      <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm flex flex-col gap-6">
        <h2 class="text-xl font-bold text-slate-800 flex items-center gap-3 border-b border-slate-100 pb-4">
          <div class="w-10 h-10 bg-teal-50 text-teal-600 rounded-xl flex items-center justify-center">
            <i class="fa-solid fa-server"></i>
          </div>
          Aktif Hizmetlerim
        </h2>
        
        <div class="flex flex-col gap-4">
          {mySites.map((site: any) => (
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 hover:border-slate-300 transition-colors">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-xl shrink-0">
                  <i class="fa-solid fa-globe"></i>
                </div>
                <div class="flex flex-col gap-1.5">
                  <a href={`http://${site.domain}`} target="_blank" class="text-[15px] font-bold text-slate-900 hover:text-blue-600 hover:underline transition-colors">{site.domain}</a>
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class={`text-[10px] uppercase font-bold px-2 py-0.5 rounded-md ${site.mode === 'urun' ? 'bg-teal-100 text-teal-700' : 'bg-purple-100 text-purple-700'}`}>
                      {site.mode === 'urun' ? '📦 Ürün' : '💼 Hizmet'} Modu
                    </span>
                    <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded-md bg-slate-200 text-slate-600">
                      {site.service_type === 'web_sitesi' ? 'Web Sitesi' : site.service_type}
                    </span>
                  </div>
                </div>
              </div>
              
              <div class="flex items-center shrink-0">
                {site.status === 'PENDING' ? (
                  <div class="flex items-center gap-2 bg-amber-50 text-amber-700 px-3 py-1.5 rounded-full text-xs font-bold border border-amber-100" title="Kurulum kuyrukta bekliyor">
                    <i class="fa-solid fa-circle-notch fa-spin"></i>
                    <span>Bekliyor</span>
                  </div>
                ) : site.status === 'ACTIVE' ? (
                  <div class="flex items-center gap-2 bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-full text-xs font-bold border border-emerald-100" title="Siteniz yayında ve aktif">
                    <span class="w-2 h-2 bg-emerald-500 rounded-full shadow-[0_0_0_2px_rgba(16,185,129,0.2)]"></span>
                    <span>Aktif</span>
                  </div>
                ) : (
                  <div class="flex items-center gap-2 bg-red-50 text-red-700 px-3 py-1.5 rounded-full text-xs font-bold border border-red-100" title="Hizmet süresi dolmuş veya askıya alınmış">
                    <span class="w-2 h-2 bg-red-500 rounded-full shadow-[0_0_0_2px_rgba(239,68,68,0.2)]"></span>
                    <span>Pasif</span>
                  </div>
                )}
              </div>
            </div>
          ))}

          {mySites.length === 0 && (
            <div class="py-12 flex flex-col items-center justify-center text-center gap-4 bg-slate-50/50 rounded-2xl border border-dashed border-slate-300 px-4">
              <i class="fa-solid fa-folder-open text-4xl text-slate-300"></i>
              <p class="text-sm text-slate-500 leading-relaxed max-w-sm">Henüz kurulmuş bir web siteniz veya hizmetiniz bulunmuyor. Soldaki formu kullanarak ilk hizmetinizi hemen oluşturun!</p>
            </div>
          )}
        </div>
      </div>

    </div>

  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const noDomainCheck = document.getElementById('no-domain-check');
      const domainInput = document.getElementById('domain');
      const desiredDomainGroup = document.getElementById('desired-domain-group');
      const desiredDomainInput = document.getElementById('desired-domain');
      const domainPrimaryGroup = document.getElementById('domain-primary-group');

      if (noDomainCheck && desiredDomainGroup && domainPrimaryGroup && domainInput && desiredDomainInput) {
        noDomainCheck.addEventListener('change', () => {
          if (noDomainCheck.checked) {
            desiredDomainGroup.classList.remove('hidden');
            desiredDomainGroup.classList.add('flex');
            domainPrimaryGroup.classList.remove('flex');
            domainPrimaryGroup.classList.add('hidden');
            domainInput.removeAttribute('required');
            desiredDomainInput.setAttribute('required', 'true');
          } else {
            desiredDomainGroup.classList.remove('flex');
            desiredDomainGroup.classList.add('hidden');
            domainPrimaryGroup.classList.remove('hidden');
            domainPrimaryGroup.classList.add('flex');
            desiredDomainInput.removeAttribute('required');
            domainInput.setAttribute('required', 'true');
          }
        });
      }
    });
  </script>
</DashboardLayout>
