---
// src/pages/user/change-password.astro
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import * as bcrypt from 'bcryptjs';

export const prerender = false;

const user = Astro.locals.user;
if (!user || user.is_partner !== 0) {
  return Astro.redirect('/login?error=unauthorized');
}

const runtime = Astro.locals.runtime as any;
const db = runtime?.env?.DB;

let successMessage = '';
let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const currentPassword = formData.get('current_password') as string;
    const newPassword = formData.get('new_password') as string;
    const newPasswordConfirm = formData.get('new_password_confirm') as string;

    if (!currentPassword || !newPassword || !newPasswordConfirm) {
      errorMessage = 'Lütfen tüm alanları doldurun.';
    } else if (newPassword !== newPasswordConfirm) {
      errorMessage = 'Yeni şifreler eşleşmiyor.';
    } else if (newPassword.length < 6) {
      errorMessage = 'Yeni şifreniz en az 6 karakter olmalıdır.';
    } else if (db) {
      // 1. Kullanıcının mevcut şifresini doğrula
      const dbUser = await db.prepare("SELECT * FROM users WHERE id = ?").bind(user.id).first() as any;
      
      if (!dbUser) {
        errorMessage = 'Kullanıcı bulunamadı.';
      } else {
        const isMatch = bcrypt.compareSync(currentPassword, dbUser.password);
        if (!isMatch) {
          errorMessage = 'Mevcut şifreniz hatalı.';
        } else {
          // 2. Yeni şifreyi hashle ve kaydet
          const salt = bcrypt.genSaltSync(10);
          const hashedPassword = bcrypt.hashSync(newPassword, salt);
          
          await db.prepare("UPDATE users SET password = ? WHERE id = ?").bind(hashedPassword, user.id).run();
          successMessage = 'Şifreniz başarıyla güncellendi.';
        }
      }
    } else {
      errorMessage = 'Veritabanı bağlantısı kurulamadı.';
    }
  } catch (err: any) {
    errorMessage = 'Şifre güncellenirken bir hata oluştu: ' + (err.message || 'Bilinmeyen hata');
  }
}
---

<DashboardLayout title="Şifre Değiştir | İş De Yeter" activeTab="change-password">
  <div class="max-w-2xl mx-auto space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Güvenlik ve Şifre</h1>
      <p class="text-gray-500 mt-1">Hesap güvenliğiniz için şifrenizi periyodik olarak değiştirmenizi öneririz.</p>
    </div>

    {successMessage && (
      <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-green-500"></i>
        <p>{successMessage}</p>
      </div>
    )}

    {errorMessage && (
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-center gap-3">
        <i class="fa-solid fa-triangle-exclamation text-red-500"></i>
        <p>{errorMessage}</p>
      </div>
    )}

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sm:p-8">
      <form method="POST" class="space-y-6">
        <div class="space-y-2">
          <label for="current_password" class="block text-sm font-medium text-gray-700">Mevcut Şifreniz</label>
          <input type="password" name="current_password" id="current_password" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" />
        </div>

        <div class="pt-4 border-t border-gray-100 space-y-4">
          <div class="space-y-2">
            <label for="new_password" class="block text-sm font-medium text-gray-700">Yeni Şifre</label>
            <input type="password" name="new_password" id="new_password" required minlength="6" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" />
            <p class="text-xs text-gray-500">En az 6 karakter uzunluğunda olmalıdır.</p>
          </div>

          <div class="space-y-2">
            <label for="new_password_confirm" class="block text-sm font-medium text-gray-700">Yeni Şifre (Tekrar)</label>
            <input type="password" name="new_password_confirm" id="new_password_confirm" required minlength="6" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" />
          </div>
        </div>

        <div class="pt-2">
          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-lg transition-colors flex justify-center items-center gap-2">
            <i class="fa-solid fa-lock"></i> Şifremi Güncelle
          </button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>
