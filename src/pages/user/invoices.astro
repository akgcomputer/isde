---
// src/pages/user/invoices.astro
import DashboardLayout from '../../layouts/DashboardLayout.astro';

export const prerender = false;

const user = Astro.locals.user;
if (!user || user.is_partner !== 0) {
  return Astro.redirect('/login?error=unauthorized');
}

const mockInvoices = [
  { id: 'FAT-2026-0012', orderId: 'SİP-10038', amount: '750 TL', date: '2026-05-15', status: 'Ödendi' }
];
---

<DashboardLayout title="Faturalarım | İş De Yeter" activeTab="invoices">
  <div class="max-w-6xl mx-auto space-y-6">
    <h1 class="text-2xl font-bold text-gray-900">Faturalarım</h1>
    <p class="text-gray-500">Aldığınız hizmetlere ait faturaları görüntüleyebilir ve indirebilirsiniz.</p>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      {mockInvoices.length > 0 ? (
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200 text-sm text-gray-600">
              <th class="py-4 px-6 font-semibold">Fatura No</th>
              <th class="py-4 px-6 font-semibold">İlgili Sipariş</th>
              <th class="py-4 px-6 font-semibold">Tarih</th>
              <th class="py-4 px-6 font-semibold">Tutar</th>
              <th class="py-4 px-6 font-semibold">Durum</th>
              <th class="py-4 px-6 font-semibold">İşlem</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 text-sm">
            {mockInvoices.map(inv => (
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="py-4 px-6 font-medium text-gray-900">{inv.id}</td>
                <td class="py-4 px-6 text-gray-600">{inv.orderId}</td>
                <td class="py-4 px-6 text-gray-600">{inv.date}</td>
                <td class="py-4 px-6 font-semibold text-gray-900">{inv.amount}</td>
                <td class="py-4 px-6">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    {inv.status}
                  </span>
                </td>
                <td class="py-4 px-6 flex gap-3">
                  <button class="text-blue-600 hover:text-blue-800 font-medium text-xs flex items-center gap-1"><i class="fa-solid fa-eye"></i> Görüntüle</button>
                  <button class="text-gray-600 hover:text-gray-900 font-medium text-xs flex items-center gap-1"><i class="fa-solid fa-download"></i> İndir</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <div class="p-12 text-center text-gray-500">
          <i class="fa-solid fa-file-invoice-dollar text-4xl mb-4 text-gray-300"></i>
          <p>Henüz bir faturanız bulunmamaktadır.</p>
        </div>
      )}
    </div>
  </div>
</DashboardLayout>
