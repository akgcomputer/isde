---
// src/pages/user/orders.astro
import DashboardLayout from '../../layouts/DashboardLayout.astro';

export const prerender = false;

const user = Astro.locals.user;
if (!user || user.is_partner !== 0) {
  return Astro.redirect('/login?error=unauthorized');
}

// TODO: Gerçek siparişleri veritabanından çekilecek
const mockOrders = [
  { id: 'SİP-10042', status: 'Hazırlanıyor', date: '2026-06-10', total: '1.250 TL', items: 'Web Sitesi Kurulumu', hasInvoice: false },
  { id: 'SİP-10038', status: 'Tamamlandı', date: '2026-05-15', total: '750 TL', items: 'Aylık SEO Paketi', hasInvoice: true }
];
---

<DashboardLayout title="Siparişlerim | İş De Yeter" activeTab="orders">
  <div class="flex flex-col gap-8 max-w-7xl mx-auto px-2">
    <div class="flex flex-col">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Siparişlerim</h1>
      <p class="text-slate-500 mt-2 text-sm sm:text-base">İş De Yeter üzerinden verdiğiniz hizmet siparişlerinin durumunu ve faturalarınızı takip edebilirsiniz.</p>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden flex flex-col">
      <div class="p-6 border-b border-slate-100 flex items-center gap-3">
        <div class="w-10 h-10 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center">
          <i class="fa-solid fa-basket-shopping"></i>
        </div>
        <h2 class="text-xl font-bold text-slate-800">Geçmiş ve Aktif Siparişler</h2>
      </div>

      {mockOrders.length > 0 ? (
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse whitespace-nowrap">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
                <th class="py-4 px-6">Sipariş Kodu</th>
                <th class="py-4 px-6">İçerik</th>
                <th class="py-4 px-6">Tarih</th>
                <th class="py-4 px-6">Tutar</th>
                <th class="py-4 px-6">Durum</th>
                <th class="py-4 px-6">Fatura</th>
                <th class="py-4 px-6 text-right">İşlem</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-sm">
              {mockOrders.map(order => (
                <tr class="hover:bg-slate-50 transition-colors group">
                  <td class="py-4 px-6">
                    <span class="font-bold text-slate-800 bg-slate-100 px-2.5 py-1 rounded-md text-[13px]">{order.id}</span>
                  </td>
                  <td class="py-4 px-6 font-semibold text-slate-700">
                    {order.items}
                  </td>
                  <td class="py-4 px-6 text-slate-500 font-medium">
                    <i class="fa-regular fa-calendar mr-1.5 text-slate-400"></i>{order.date}
                  </td>
                  <td class="py-4 px-6 font-extrabold text-emerald-600">
                    {order.total}
                  </td>
                  <td class="py-4 px-6">
                    <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-[11px] font-bold uppercase tracking-wide ${order.status === 'Tamamlandı' ? 'bg-emerald-50 text-emerald-700' : 'bg-blue-50 text-blue-700'}`}>
                      <i class={`fa-solid ${order.status === 'Tamamlandı' ? 'fa-check' : 'fa-spinner fa-spin-pulse'}`}></i>
                      {order.status}
                    </span>
                  </td>
                  <td class="py-4 px-6">
                    {order.hasInvoice ? (
                      <div class="flex items-center gap-2">
                        <button onclick="alert('Fatura detayı yükleniyor...')" class="bg-white border border-slate-200 hover:border-slate-300 text-slate-600 hover:text-slate-800 font-bold text-[11px] px-2.5 py-1.5 rounded-md transition-all shadow-sm">
                          <i class="fa-solid fa-eye"></i> Görüntüle
                        </button>
                        <button onclick="alert('Fatura PDF olarak indiriliyor...')" class="bg-white border border-slate-200 hover:border-slate-300 text-slate-600 hover:text-slate-800 font-bold text-[11px] px-2.5 py-1.5 rounded-md transition-all shadow-sm">
                          <i class="fa-solid fa-download"></i> İndir
                        </button>
                      </div>
                    ) : (
                      <span class="text-red-500 font-bold text-[11px] bg-red-50 px-2.5 py-1 rounded-md">
                        <i class="fa-solid fa-triangle-exclamation"></i> Faturalandırılmadı
                      </span>
                    )}
                  </td>
                  <td class="py-4 px-6 text-right">
                    <button class="bg-white border border-slate-200 hover:border-blue-300 text-blue-600 hover:text-blue-700 hover:bg-blue-50 font-bold text-xs px-4 py-2 rounded-lg transition-all shadow-sm">
                      Detaylar
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="py-20 flex flex-col items-center justify-center text-center gap-4 bg-slate-50/50">
          <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center text-slate-300 text-4xl shadow-sm border border-slate-100">
            <i class="fa-solid fa-box-open"></i>
          </div>
          <p class="text-slate-500 font-medium max-w-sm mt-2">Henüz bir siparişiniz bulunmamaktadır.</p>
        </div>
      )}
    </div>
  </div>
</DashboardLayout>
