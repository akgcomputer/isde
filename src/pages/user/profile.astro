---
// src/pages/user/profile.astro
import DashboardLayout from '../../layouts/DashboardLayout.astro';

export const prerender = false; // Sunucu tarafında anlık çalışmalıdır (SSR)

const user = Astro.locals.user;
if (!user || user.is_partner !== 0) {
  return Astro.redirect('/login?error=unauthorized');
}

const runtime = Astro.locals.runtime as any;
const db = runtime?.env?.DB;

let successMessage = '';
let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const name = formData.get('name') as string;
    const phone = formData.get('phone') as string;
    const address = formData.get('address') as string;
    const billingInfo = formData.get('billing_info') as string;

    if (!name || name.trim() === '') {
      errorMessage = 'Ad Soyad / Firma Adı alanı boş bırakılamaz.';
    } else {
      if (db) {
        // Profil bilgilerini veritabanında güncelle
        await db.prepare(
          "UPDATE users SET name = ?, phone = ?, address = ?, billing_info = ? WHERE id = ?"
        ).bind(name, phone, address, billingInfo, user.id).run();
        
        // locals.user bilgisini de güncelleyelim ki yeni bilgiler ekrana yansısın
        user.name = name;
        user.phone = phone;
        user.address = address;
        user.billing_info = billingInfo;

        successMessage = 'Profil ve fatura bilgileriniz başarıyla güncellendi.';
      } else {
        errorMessage = 'Veritabanı bağlantısı yok.';
      }
    }
  } catch (e) {
    console.error("Profile update error:", e);
    errorMessage = 'Profil bilgileri güncellenirken bir hata oluştu.';
  }
}
---

<DashboardLayout title="Profil & Fatura | İş De Yeter" activeTab="profile">
  <div class="profile-editor">
    
    <div class="editor-header">
      <h1>Profil & Fatura Ayarları</h1>
      <p>Kişisel bilgilerinizi ve fatura detaylarınızı buradan düzenleyebilirsiniz.</p>
    </div>

    <!-- Alert Messages -->
    {successMessage && (
      <div class="alert success">
        <i class="fa-solid fa-circle-check"></i>
        <span>{successMessage}</span>
      </div>
    )}

    {errorMessage && (
      <div class="alert error">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>{errorMessage}</span>
      </div>
    )}

    <!-- Form -->
    <form method="POST" class="profile-form shadow-card">
      
      <div class="form-section">
        <h2><i class="fa-solid fa-user-tie text-blue-500 mr-2"></i>Kişisel Bilgiler</h2>
        <div class="grid-2">
          
          <div class="form-group">
            <label for="name">Ad Soyad / Firma Adı *</label>
            <input 
              type="text" 
              name="name" 
              id="name" 
              value={user.name} 
              required 
              placeholder="Adınızı ve soyadınızı girin"
            />
          </div>

          <div class="form-group">
            <label for="phone">Telefon Numarası</label>
            <input 
              type="tel" 
              name="phone" 
              id="phone" 
              value={user.phone || ''} 
              placeholder="05xx xxx xx xx"
            />
          </div>

          <div class="form-group full-width">
            <label for="email">E-Posta Adresi (Değiştirilemez)</label>
            <input 
              type="email" 
              id="email" 
              value={user.email} 
              disabled 
              class="disabled-input"
            />
          </div>

          <div class="form-group full-width">
            <label for="address">Adres Bilgisi</label>
            <textarea 
              name="address" 
              id="address" 
              rows="3" 
              placeholder="Hizmet alırken kullanılacak varsayılan adresinizi girin"
            >{user.address || ''}</textarea>
          </div>

        </div>
      </div>

      <hr class="divider" />

      <div class="form-section">
        <h2><i class="fa-solid fa-file-invoice text-orange-500 mr-2"></i>Fatura & Vergi Detayları</h2>
        <div class="form-group full-width">
          <label for="billing_info">Fatura Detayları</label>
          <textarea 
            name="billing_info" 
            id="billing_info" 
            rows="3" 
            placeholder="Vergi Dairesi, Vergi No, Şirket Unvanı veya T.C. Kimlik numaranızı girin"
          >{user.billing_info || ''}</textarea>
        </div>
      </div>

      <div class="actions">
        <button type="submit" class="save-btn">
          <i class="fa-solid fa-floppy-disk mr-2"></i>
          <span>Değişiklikleri Kaydet</span>
        </button>
      </div>

    </form>

  </div>

  <style>
    .profile-editor {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .editor-header h1 {
      font-size: 2rem;
      color: #0f172a;
      letter-spacing: -0.5px;
    }

    .editor-header p {
      font-size: 0.95rem;
      color: #64748b;
      margin-top: 4px;
    }

    /* Alerts */
    .alert {
      padding: 16px 20px;
      border-radius: 12px;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 0.95rem;
    }

    .alert.success {
      background: rgba(16, 185, 129, 0.05);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #059669;
    }

    .alert.error {
      background: rgba(239, 68, 68, 0.05);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #dc2626;
    }

    /* Card Form */
    .shadow-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 20px;
      padding: 32px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .form-section {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .form-section h2 {
      font-size: 1.15rem;
      color: #1e293b;
      font-weight: 700;
      display: flex;
      align-items: center;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group.full-width {
      grid-column: span 2;
    }

    label {
      font-size: 0.88rem;
      font-weight: 600;
      color: #475569;
    }

    input, textarea {
      font-family: inherit;
      font-size: 0.92rem;
      padding: 12px 16px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      background: #ffffff;
      color: #0f172a;
      transition: all 0.2s ease;
    }

    input:focus, textarea:focus {
      outline: none;
      border-color: #3b82f6;
      box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    }

    .disabled-input {
      background: #f1f5f9;
      color: #64748b;
      cursor: not-allowed;
      border-color: #e2e8f0;
    }

    .divider {
      border: none;
      border-top: 1px solid #e2e8f0;
    }

    /* Actions save button */
    .actions {
      display: flex;
      justify-content: flex-end;
    }

    .save-btn {
      background: #3b82f6;
      color: #ffffff;
      border: none;
      padding: 14px 32px;
      font-size: 0.95rem;
      font-weight: 600;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      transition: all 0.2s ease;
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
    }

    .save-btn:hover {
      background: #2563eb;
      box-shadow: 0 8px 20px rgba(59, 130, 246, 0.25);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .grid-2 {
        grid-template-columns: 1fr;
      }
      .form-group.full-width {
        grid-column: span 1;
      }
      .shadow-card {
        padding: 20px;
      }
    }
  </style>
</DashboardLayout>

