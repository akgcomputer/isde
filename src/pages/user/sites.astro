---
// src/pages/user/sites.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

export const prerender = false; // Sunucu tarafında anlık çalışmalıdır (SSR)

const user = Astro.locals.user;
if (!user || user.is_partner !== 0) {
  return Astro.redirect('/login?error=unauthorized');
}

const runtime = Astro.locals.runtime as any;
const db = runtime?.env?.DB;

let successMessage = '';
let errorMessage = '';

// Form Gönderim (POST) - Yeni Hizmet / Site Talebi
if (Astro.request.method === 'POST' && db) {
  try {
    const formData = await Astro.request.formData();
    const addressType = formData.get('address_type') as string;
    let domainInput = (formData.get('domain') as string || '').trim().toLowerCase();
    const mode = formData.get('mode') as string;

    if (!domainInput) {
      errorMessage = 'Lütfen geçerli bir alan adı veya alt alan adı girin.';
    } else {
      let finalDomain = domainInput;

      if (addressType === 'subdomain') {
        // Sadece harf, rakam ve tire kontrolü
        const subdomainRegex = /^[a-z0-9-]+$/;
        if (!subdomainRegex.test(domainInput)) {
          errorMessage = 'Alt alan adı sadece küçük harf, rakam ve tire (-) içerebilir.';
        } else {
          finalDomain = `${domainInput}.isdeyeter.com`;
        }
      } else {
        // Özel alan adı validation
        const domainRegex = /^[a-z0-9]+([\-\.]{1}[a-z0-9]+)*\.[a-z]{2,5}$/;
        if (!domainRegex.test(domainInput)) {
          errorMessage = 'Geçersiz özel alan adı formatı (Örn: firmam.com).';
        } else {
          // Alt alan adı kontrolü
          const dots = (domainInput.match(/\./g) || []).length;
          const isTr = domainInput.endsWith('.com.tr') || domainInput.endsWith('.net.tr') || domainInput.endsWith('.org.tr');
          if ((dots > 1 && !isTr) || (dots > 2 && isTr)) {
            errorMessage = 'Web paketleri sadece ana alan adı için kurulabilir. Alt alan adı (subdomain) girilemez!';
          }
        }
      }

      if (!errorMessage) {
        // Veritabanında çakışma var mı kontrol et
        const existing = await db.prepare("SELECT * FROM sites WHERE domain = ?").bind(finalDomain).first();

        if (existing) {
          errorMessage = `"${finalDomain}" adresi zaten kullanımda. Lütfen başka bir adres seçin.`;
        } else {
          // 1. Veritabanına PENDING durumunda ekle (service_type: 'web_sitesi')
          await db.prepare(
            "INSERT INTO sites (user_id, domain, mode, status, service_type) VALUES (?, ?, ?, 'PENDING', 'web_sitesi')"
          ).bind(user.id, finalDomain, mode).run();

          // 2. n8n Webhook Tetikleme (Mock / Test amaçlı çalışır)
          const n8nUrl = runtime.env.N8N_WEBHOOK_URL || 'https://n8n.isdeyeter.com/webhook/mock-site-builder';
          const payload = {
            user_id: user.id,
            user_email: user.email,
            user_name: user.name,
            domain: finalDomain,
            mode: mode,
            timestamp: new Date().toISOString()
          };

          try {
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 4000);

            fetch(n8nUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
              signal: controller.signal
            }).then(res => {
              clearTimeout(timeoutId);
              console.log(`n8n webhook tetiklendi. Durum: ${res.status}`);
            }).catch(err => {
              clearTimeout(timeoutId);
              console.error("n8n Webhook HTTP Hatası:", err.message);
            });
          } catch (webhookErr) {
            console.error("Webhook Trigger Fail:", webhookErr);
          }

          successMessage = `"${finalDomain}" adresli web sitenizin kurulum talebi başarıyla alındı! Sistem arka planda otomatik kurulumu başlattı.`;
        }
      }
    }
  } catch (e) {
    console.error("Site creation error:", e);
    errorMessage = 'Hizmet oluşturulurken beklenmedik bir sistem hatası oluştu.';
  }
}

// Kayıtlı siteleri listele
let mySites: any[] = [];
if (db) {
  try {
    const query = await db.prepare("SELECT * FROM sites WHERE user_id = ? ORDER BY created_at DESC").bind(user.id).all();
    mySites = query.results || [];
  } catch (e) {
    console.error("Fetch sites D1 error:", e);
  }
}
---

<DashboardLayout title="Ücretsiz Hizmetlerim | İş De Yeter" activeTab="sites">
  <div class="sites-wizard">
    
    <div class="wizard-header">
      <h1>Ücretsiz Hizmetlerim & Sitelerim</h1>
      <p>Web altyapısını kullanarak kendi markanıza özel profesyonel hizmet veya ürün katalog sitenizi saniyeler içinde kurma talebi gönderin.</p>
    </div>

    <!-- Alerts -->
    {successMessage && (
      <div class="alert success">
        <i class="fa-solid fa-circle-check"></i>
        <span>{successMessage}</span>
      </div>
    )}

    {errorMessage && (
      <div class="alert error">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>{errorMessage}</span>
      </div>
    )}

    <!-- Split content: Form on left, active sites on right -->
    <div class="wizard-layout">
      
      <!-- Creation Form -->
      <form method="POST" class="wizard-form shadow-card">
        <h2><i class="fa-solid fa-wand-magic-sparkles text-blue-500 mr-2"></i>Yeni Web Sitesi Başlat</h2>
        
        <div class="form-group">
          <label>Adres Tipi Seçin</label>
          <div class="address-type-selector">
            <label class="radio-label">
              <input type="radio" name="address_type" value="subdomain" checked id="type-subdomain" />
              <span>Ücretsiz Alt Alan Adı (.isdeyeter.com)</span>
            </label>
            <label class="radio-label">
              <input type="radio" name="address_type" value="domain" id="type-domain" />
              <span>Kendi Özel Alan Adım (Domain)</span>
            </label>
          </div>
        </div>

        <div class="form-group">
          <label for="domain" id="domain-label">Alan Adı (Subdomain)</label>
          <div class="domain-input-group">
            <input 
              type="text" 
              name="domain" 
              id="domain" 
              required 
              placeholder="firmaadi" 
              class="domain-input"
            />
            <span class="domain-suffix" id="domain-suffix">.isdeyeter.com</span>
          </div>
          <small class="helper-text" id="domain-helper">Sadece küçük harfler, rakamlar ve tire (-) kullanın. Türkçe karakter kullanmayın.</small>
        </div>

        <div class="form-group">
          <label for="mode">Web Sitesi Çalışma Modu (Model)</label>
          <select name="mode" id="mode" class="mode-select" required>
            <option value="hizmet">💼 Hizmet Kataloğu Modu (Servis odaklı firmalar için)</option>
            <option value="urun">📦 E-Ticaret / Ürün Kataloğu Modu (Ürün odaklı satıcılar için)</option>
          </select>
          <small class="helper-text">Mod seçimi sitenizin menü yapısını otomatik belirler.</small>
        </div>

        <button type="submit" class="submit-btn">
          <i class="fa-solid fa-cloud-arrow-up mr-2"></i>
          <span>Kurulum Talebi Gönder</span>
        </button>
      </form>

      <!-- Active Sites List -->
      <div class="sites-list shadow-card">
        <h2><i class="fa-solid fa-server text-teal-500 mr-2"></i>Aktif Hizmetlerim</h2>
        
        <div class="list-container">
          {mySites.map(site => (
            <div class="site-row">
              <div class="site-info">
                <i class="fa-solid fa-globe site-globe"></i>
                <div class="site-meta">
                  <a href={`http://${site.domain}`} target="_blank" class="site-domain">{site.domain}</a>
                  <div class="meta-row">
                    <span class={`site-mode ${site.mode}`}>
                      {site.mode === 'urun' ? '📦 Ürün' : '💼 Hizmet'} Modu
                    </span>
                    <span class="service-type-badge">
                      {site.service_type === 'web_sitesi' ? 'Web Sitesi' : site.service_type}
                    </span>
                  </div>
                </div>
              </div>
              
              <div class="site-status-area">
                {site.status === 'PENDING' ? (
                  <div class="status-indicator pending" title="Kurulum kuyrukta bekliyor">
                    <span class="spinner"></span>
                    <span>Bekliyor...</span>
                  </div>
                ) : site.status === 'ACTIVE' ? (
                  <div class="status-indicator active" title="Siteniz yayında ve aktif">
                    <span class="active-dot"></span>
                    <span>Aktif</span>
                  </div>
                ) : (
                  <div class="status-indicator passive" title="Hizmet süresi dolmuş veya askıya alınmış">
                    <span class="passive-dot"></span>
                    <span>Pasif</span>
                  </div>
                )}
              </div>
            </div>
          ))}

          {mySites.length === 0 && (
            <div class="empty-state">
              <i class="fa-solid fa-folder-open empty-icon"></i>
              <p>Henüz kurulmuş bir web siteniz veya hizmetiniz bulunmuyor. Soldaki formu kullanarak ilk hizmetinizi hemen oluşturun!</p>
            </div>
          )}
        </div>
      </div>

    </div>

  </div>

  <script>
    const typeSubdomain = document.getElementById('type-subdomain') as HTMLInputElement;
    const typeDomain = document.getElementById('type-domain') as HTMLInputElement;
    const domainLabel = document.getElementById('domain-label') as HTMLLabelElement;
    const domainInput = document.getElementById('domain') as HTMLInputElement;
    const domainSuffix = document.getElementById('domain-suffix') as HTMLSpanElement;
    const domainHelper = document.getElementById('domain-helper') as HTMLElement;

    if (typeSubdomain && typeDomain && domainLabel && domainInput && domainSuffix && domainHelper) {
      typeSubdomain.addEventListener('change', updateFormState);
      typeDomain.addEventListener('change', updateFormState);

      function updateFormState() {
        if (typeSubdomain.checked) {
          domainLabel.textContent = "Alt Alan Adı (Subdomain)";
          domainInput.placeholder = "firmaadi";
          domainSuffix.style.display = "flex";
          domainHelper.textContent = "Sadece küçük harfler, rakamlar ve tire (-) kullanın. Türkçe karakter kullanmayın.";
        } else {
          domainLabel.textContent = "Kendi Özel Alan Adınız (Domain)";
          domainInput.placeholder = "firmamiz.com";
          domainSuffix.style.display = "none";
          domainHelper.textContent = "Satın aldığınız alan adını girin (Örn: firmamiz.com). Alt alan adı girilemez.";
        }
      }
    }
  </script>

  <style>
    .sites-wizard {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .wizard-header h1 {
      font-size: 2rem;
      color: #0f172a;
      letter-spacing: -0.5px;
    }

    .wizard-header p {
      font-size: 0.95rem;
      color: #64748b;
      margin-top: 4px;
    }

    /* Alerts */
    .alert {
      padding: 16px 20px;
      border-radius: 12px;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 0.95rem;
    }

    .alert.success {
      background: rgba(16, 185, 129, 0.05);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #059669;
    }

    .alert.error {
      background: rgba(239, 68, 68, 0.05);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #dc2626;
    }

    /* Layout Split */
    .wizard-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      align-items: start;
    }

    .shadow-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 20px;
      padding: 32px;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .wizard-layout h2 {
      font-size: 1.15rem;
      color: #1e293b;
      font-weight: 700;
      display: flex;
      align-items: center;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    label {
      font-size: 0.88rem;
      font-weight: 600;
      color: #475569;
    }

    /* Address Type Selector */
    .address-type-selector {
      display: flex;
      gap: 16px;
      margin-bottom: 8px;
      flex-wrap: wrap;
    }

    .radio-label {
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      font-size: 0.88rem;
      color: #334155;
    }

    .radio-label input {
      cursor: pointer;
    }

    /* Domain input group styling */
    .domain-input-group {
      display: flex;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      overflow: hidden;
      background: #ffffff;
      transition: all 0.2s ease;
    }

    .domain-input-group:focus-within {
      border-color: #3b82f6;
      box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    }

    .domain-input {
      border: none;
      flex: 1;
      font-family: inherit;
      font-size: 0.92rem;
      padding: 12px 16px;
      color: #0f172a;
      outline: none;
      background: transparent;
    }

    .domain-suffix {
      background: #f1f5f9;
      color: #64748b;
      font-weight: 600;
      font-size: 0.92rem;
      padding: 12px 16px;
      border-left: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      user-select: none;
    }

    .helper-text {
      font-size: 0.78rem;
      color: #64748b;
    }

    /* Select design */
    .mode-select {
      font-family: inherit;
      font-size: 0.92rem;
      padding: 12px 16px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      color: #0f172a;
      background: #ffffff;
      outline: none;
    }

    .mode-select:focus {
      border-color: #3b82f6;
    }

    /* Submit btn */
    .submit-btn {
      background: #3b82f6;
      color: #ffffff;
      border: none;
      padding: 14px;
      font-size: 0.95rem;
      font-weight: 600;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
      margin-top: 10px;
    }

    .submit-btn:hover {
      background: #2563eb;
      box-shadow: 0 8px 20px rgba(59, 130, 246, 0.25);
    }

    /* Active sites list styling */
    .list-container {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .site-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      padding: 16px;
    }

    .site-info {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .site-globe {
      font-size: 1.6rem;
      color: #3b82f6;
      background: rgba(59, 130, 246, 0.08);
      width: 48px;
      height: 48px;
      border-radius: 10px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .site-meta {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .site-domain {
      font-size: 0.95rem;
      font-weight: 700;
      color: #0f172a;
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .site-domain:hover {
      color: #2563eb;
      text-decoration: underline;
    }

    .meta-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .site-mode {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      width: fit-content;
    }

    .site-mode.hizmet { background: rgba(168, 85, 247, 0.08); color: #a855f7; }
    .site-mode.urun { background: rgba(20, 184, 166, 0.08); color: #0d9488; }

    .service-type-badge {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      background: #e2e8f0;
      color: #475569;
    }

    /* Site status tag indicators */
    .status-indicator {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 6px 12px;
      border-radius: 20px;
    }

    .status-indicator.pending {
      background: rgba(245, 158, 11, 0.08);
      color: #d97706;
    }

    .status-indicator.active {
      background: rgba(16, 185, 129, 0.08);
      color: #059669;
    }

    .status-indicator.passive {
      background: rgba(220, 38, 38, 0.08);
      color: #dc2626;
    }

    /* Active flashing dot */
    .active-dot {
      width: 6px;
      height: 6px;
      background: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    }

    /* Passive dot */
    .passive-dot {
      width: 6px;
      height: 6px;
      background: #dc2626;
      border-radius: 50%;
      box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.2);
    }

    /* Spinner loader animation for pending provisioning */
    .spinner {
      width: 12px;
      height: 12px;
      border: 2px solid rgba(245, 158, 11, 0.2);
      border-top: 2px solid #f59e0b;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    /* Empty lists */
    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 12px;
      padding: 40px 20px;
    }

    .empty-icon {
      font-size: 2.5rem;
      color: #cbd5e1;
    }

    .empty-state p {
      font-size: 0.88rem;
      color: #64748b;
      line-height: 1.4;
    }

    /* Responsive */
    @media (max-width: 992px) {
      .wizard-layout {
        grid-template-columns: 1fr;
      }
    }
  </style>
</DashboardLayout>

