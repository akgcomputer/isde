---
// src/pages/user/support.astro
import DashboardLayout from '../../layouts/DashboardLayout.astro';

export const prerender = false;

const user = Astro.locals.user;
if (!user || user.is_partner !== 0) {
  return Astro.redirect('/login?error=unauthorized');
}

const mockTickets = [
  { id: 'DS-1024', subject: 'Siteme yeni sayfa ekleyemiyorum', status: 'Yanıtlandı', date: '2026-06-08' }
];
---

<DashboardLayout title="Destek Talepleri | İş De Yeter" activeTab="support">
  <div class="max-w-6xl mx-auto space-y-6">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Destek Taleplerim</h1>
        <p class="text-gray-500">Yaşadığınız sorunlarla ilgili destek ekibimize ulaşabilirsiniz.</p>
      </div>
      <button onclick="alert('Destek bildirim sistemi altyapısı hazırlanmaktadır. Acil talepleriniz için WhatsApp destek hattımıza yazabilirsiniz.')" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg font-medium text-sm transition-colors flex items-center gap-2">
        <i class="fa-solid fa-plus"></i> Destek Talebi Oluştur
      </button>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mt-6">
      {mockTickets.length > 0 ? (
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200 text-sm text-gray-600">
              <th class="py-4 px-6 font-semibold">Talep No</th>
              <th class="py-4 px-6 font-semibold">Konu</th>
              <th class="py-4 px-6 font-semibold">Tarih</th>
              <th class="py-4 px-6 font-semibold">Durum</th>
              <th class="py-4 px-6 font-semibold">İşlem</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 text-sm">
            {mockTickets.map(ticket => (
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="py-4 px-6 font-medium text-gray-900">{ticket.id}</td>
                <td class="py-4 px-6 text-gray-800">{ticket.subject}</td>
                <td class="py-4 px-6 text-gray-600">{ticket.date}</td>
                <td class="py-4 px-6">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                    {ticket.status}
                  </span>
                </td>
                <td class="py-4 px-6">
                  <button onclick="alert('Bilet detayı sayfası henüz aktif değil. WhatsApp üzerinden durumunu sorgulayabilirsiniz.')" class="text-blue-600 hover:text-blue-800 font-medium text-xs">Görüntüle</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <div class="p-12 text-center text-gray-500">
          <i class="fa-solid fa-life-ring text-4xl mb-4 text-gray-300"></i>
          <p>Henüz bir destek talebiniz bulunmamaktadır.</p>
        </div>
      )}
    </div>
  </div>
</DashboardLayout>
